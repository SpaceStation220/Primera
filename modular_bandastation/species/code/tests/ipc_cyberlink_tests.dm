/// Item force belongs to the attack, while incoming vulnerability belongs to the installed core.
/datum/unit_test/ipc_cyberlink_weaknesses/Run()
	var/mob/living/carbon/human/ipc = allocate(/mob/living/carbon/human/consistent)
	ipc.set_species(/datum/species/ipc)
	var/datum/preference/choiced/ipc/generation/preference = GLOB.preference_entries[/datum/preference/choiced/ipc/generation]
	preference.apply_to_human(ipc, "IV", null)
	TEST_ASSERT(ipc.is_ipc_generation("IV"), "Generation IV could not be selected.")
	var/obj/item/crowbar/weapon = allocate(/obj/item/crowbar)
	weapon.force = 20
	weapon.wound_bonus = CANT_WOUND
	ipc.put_in_active_hand(weapon, forced = TRUE)
	ipc.set_combat_mode(TRUE)
	ADD_TRAIT(ipc, TRAIT_PERFECT_ATTACKER, TRAIT_SOURCE_UNIT_TESTS)
	var/mob/living/carbon/human/victim = allocate(/mob/living/carbon/human/consistent)
	weapon.melee_attack_chain(ipc, victim, list(RIGHT_CLICK = FALSE))
	TEST_ASSERT_EQUAL(victim.get_brute_loss(), 17, "Generation IV did not reduce a real melee weapon hit by fifteen percent.")
	TEST_ASSERT_EQUAL(weapon.force, 20, "Generation IV changed the shared weapon's force.")
	var/obj/structure/closet/crate/first_crate = allocate(/obj/structure/closet/crate)
	var/before = first_crate.get_integrity()
	weapon.attack_atom(first_crate, ipc)
	var/iv_damage = before - first_crate.get_integrity()
	var/mob/living/carbon/human/ordinary = allocate(/mob/living/carbon/human/consistent)
	var/obj/structure/closet/crate/second_crate = allocate(/obj/structure/closet/crate)
	before = second_crate.get_integrity()
	weapon.attack_atom(second_crate, ordinary)
	TEST_ASSERT(abs(iv_damage - (before - second_crate.get_integrity()) * 0.85) < 0.00001, "Object attacks missed the generation weakness or damaged the next user's weapon.")
	var/obj/item/bodypart/arm = ipc.get_bodypart(BODY_ZONE_L_ARM)
	arm.receive_damage(brute = 10, burn = 10, wound_bonus = CANT_WOUND)
	TEST_ASSERT_EQUAL(arm.brute_dam, 11, "Generation IV did not take ten percent more brute damage.")
	TEST_ASSERT_EQUAL(arm.burn_dam, 10, "Generation IV incorrectly changed burn damage.")
	arm.heal_damage(brute = 11, burn = 10)
	TEST_ASSERT_EQUAL(arm.brute_dam + arm.burn_dam, 0, "Generation weakness changed repair amounts.")
	var/obj/item/bodypart/chest/robot/ipc/torso = ipc.get_bodypart(BODY_ZONE_CHEST)
	torso.ipc_manufacturer = /datum/ipc_manufacturer/hephaestus::name
	arm.receive_damage(brute = 20, wound_bonus = CANT_WOUND)
	TEST_ASSERT(abs(arm.brute_dam - 21.12) < 0.00001, "Generation and physical brand did not compose once.")
	var/obj/item/organ/brain/organic = allocate(/obj/item/organ/brain)
	TEST_ASSERT(organic.Insert(ipc, movement_flags = DELETE_IF_REPLACED), "Control brain replacement failed.")
	TEST_ASSERT(!ipc.is_ipc_generation("IV"), "A replacement brain inherited generation IV from the body.")
	arm.heal_damage(brute = 100)
	arm.receive_damage(brute = 10, wound_bonus = CANT_WOUND)
	TEST_ASSERT(abs(arm.brute_dam - 9.6) < 0.00001, "Generation vulnerability remained after removing its core.")

/// The system program and individual machine memories survive a real core transplantation.
/datum/unit_test/ipc_cyberlink_core_memory/Run()
	var/mob/living/carbon/human/ipc = allocate(/mob/living/carbon/human/consistent)
	ipc.set_species(/datum/species/ipc)
	var/datum/preference/choiced/ipc/generation/preference = GLOB.preference_entries[/datum/preference/choiced/ipc/generation]
	preference.apply_to_human(ipc, "IV", null)
	var/datum/ipc_os/os = ipc.get_ipc_os()
	var/datum/ipc_os_program/cyberlink/program = os.programs["cyberlink"]
	TEST_ASSERT(program.available() && program.builtin && program.installed && program.remote_enabled, "Generation IV did not receive the enabled system program.")
	TEST_ASSERT_EQUAL(program.name, "ChromieКnight 4.4", "System program name differs from the user-approved spelling.")
	TEST_ASSERT_EQUAL(os.used_storage(), 0, "The generation system program consumed storage.")
	TEST_ASSERT(!os.install(program.id) && !os.begin_download(program.id) && !os.uninstall(program.id), "System program accepted NET installation/removal.")
	var/obj/machinery/camera/first = allocate(/obj/machinery/camera)
	var/obj/machinery/camera/second = allocate(/obj/machinery/camera)
	var/datum/ipc_cyberlink_memory/first_memory = program.remember(first)
	TEST_ASSERT_EQUAL(program.remember(first), first_memory, "The same physical machine was remembered twice.")
	TEST_ASSERT(program.remember(second) != first_memory, "Two identical machines shared a memory record.")
	qdel(first)
	TEST_ASSERT_NULL(first_memory.target_ref.resolve(), "Destroyed machine retained a live neural record.")
	TEST_ASSERT(!program.has_memory(first) && !program.has_memory(null), "A dead memory record matched a nonexistent target.")
	var/obj/machinery/camera/replacement = allocate(/obj/machinery/camera)
	TEST_ASSERT(program.remember(replacement) != first_memory, "A replacement machine inherited destroyed-machine memory.")
	program.remote_enabled = FALSE
	var/obj/item/organ/brain/ipc/core = ipc.get_organ_slot(ORGAN_SLOT_BRAIN)
	core.Remove(ipc, special = TRUE)
	var/mob/living/carbon/human/recipient = allocate(/mob/living/carbon/human/consistent)
	recipient.set_species(/datum/species/ipc)
	TEST_ASSERT(core.Insert(recipient, movement_flags = DELETE_IF_REPLACED), "Cyberlink core transplantation failed.")
	TEST_ASSERT_EQUAL(recipient.get_ipc_os().programs["cyberlink"], program, "Transplant recreated the system program.")
	TEST_ASSERT_EQUAL(length(program.memory), 3, "Transplant discarded per-instance neural memory.")
	TEST_ASSERT(!program.remote_enabled, "Transplant reset the user's remote-control toggle.")
	TEST_ASSERT_NULL(ipc.get_ipc_os(), "Generation IV program leaked onto the former body.")

/// Actual diagnostics debit the real battery only for a visible supported target and an authorized user.
/datum/unit_test/ipc_cyberlink_scanner_energy/Run()
	var/mob/living/carbon/human/ipc = allocate(/mob/living/carbon/human/consistent)
	ipc.set_species(/datum/species/ipc)
	ipc.mock_client = allocate(/datum/client_interface)
	var/datum/preference/choiced/ipc/generation/preference = GLOB.preference_entries[/datum/preference/choiced/ipc/generation]
	preference.apply_to_human(ipc, "IV", null)
	var/datum/ipc_os/os = ipc.get_ipc_os()
	var/datum/ipc_os_program/cyberlink/program = os.programs["cyberlink"]
	program.start()
	ipc.set_nutrition(100, forced = TRUE)
	var/obj/machinery/camera/target = allocate(/obj/machinery/camera, get_step(ipc, EAST))
	TEST_ASSERT(program.scan_machine(ipc, target), "Visible electronics could not be diagnosed.")
	TEST_ASSERT_EQUAL(ipc.nutrition, 94.5, "Diagnostic request did not cost one percent of a normal battery.")
	TEST_ASSERT_EQUAL(length(program.memory), 0, "Diagnostics bypassed routing and learned a machine.")
	TEST_ASSERT(os.install("power_save"), "PowerSave could not be installed through the normal OS path.")
	var/datum/ipc_os_program/power_save/power_save = os.programs["power_save"]
	TEST_ASSERT(!power_save.running && program.charge_cost(1) == 5.5, "Installed but disabled PowerSave changed Cyberlink costs.")
	TEST_ASSERT(power_save.start(), "PowerSave could not be enabled through its normal lifecycle.")
	var/before = ipc.nutrition
	TEST_ASSERT(program.scan_machine(ipc, target), "PowerSave prevented diagnostics.")
	TEST_ASSERT(abs(before - ipc.nutrition - 4.675) < 0.0001, "ChromieKnight did not apply exactly one fifteen-percent PowerSave discount.")
	var/obj/item/bodypart/chest/robot/ipc/torso = ipc.get_bodypart(BODY_ZONE_CHEST)
	torso.ipc_manufacturer = /datum/ipc_manufacturer/ward::name
	before = ipc.nutrition
	TEST_ASSERT(program.scan_machine(ipc, target), "Ward chassis could not use diagnostics.")
	TEST_ASSERT(abs(before - ipc.nutrition - 5.61) < 0.0001, "Diagnostic cost did not use the physical Ward capacity.")
	TEST_ASSERT(os.uninstall("power_save"), "PowerSave removal failed.")
	before = ipc.nutrition
	TEST_ASSERT(program.scan_machine(ipc, target), "Diagnostics failed after PowerSave removal.")
	TEST_ASSERT(abs(before - ipc.nutrition - 6.6) < 0.0001, "PowerSave discount persisted after removal.")
	var/turf/source_turf = get_turf(ipc)
	var/obj/machinery/computer/console = allocate(/obj/machinery/computer, locate(source_turf.x + 4, source_turf.y, source_turf.z))
	TEST_ASSERT(console in program.machine_targets(), "Remote Control did not reach a machine four tiles away.")
	var/turf/out_of_range = locate(source_turf.x + 5, source_turf.y, source_turf.z)
	console.forceMove(out_of_range)
	TEST_ASSERT(!(console in program.machine_targets()), "Remote Control reached a machine five tiles away.")
	target.forceMove(out_of_range)
	before = ipc.nutrition
	TEST_ASSERT(!program.scan_machine(ipc, target), "Scanner reached beyond four tiles.")
	var/mob/living/carbon/human/stranger = allocate(/mob/living/carbon/human/consistent)
	TEST_ASSERT(!program.scan_machine(stranger, target), "Another player could spend the owner's battery.")
	TEST_ASSERT_EQUAL(ipc.nutrition, before, "Rejected requests consumed energy.")
