/// Native job access and software exclusions apply to downloads, storage and execution without an ID.
/datum/unit_test/ipc_os_pda_software_policy/Run()
	var/mob/living/carbon/human/ipc = allocate(/mob/living/carbon/human/consistent)
	ipc.set_species(/datum/species/ipc)
	ipc.mind_initialize()
	var/datum/job/scientist = SSjob.get_job_type(/datum/job/scientist)
	ipc.mind.set_assigned_role(scientist)
	SEND_GLOBAL_SIGNAL(COMSIG_GLOB_JOB_AFTER_SPAWN, scientist, ipc, null)
	var/datum/ipc_os/os = ipc.get_ipc_os()
	os.install("pda")
	var/datum/ipc_os_program/pda/pda = os.programs["pda"]
	TEST_ASSERT(pda.start(), "Digital PDA did not start.")
	var/obj/item/modular_computer/pda/ipc_os/device = pda.device
	TEST_ASSERT_EQUAL(device.max_capacity, 64, "Digital PDA does not have a 64 GQ drive.")
	TEST_ASSERT_NULL(device.stored_id, "Digital PDA fabricated a credential item.")
	var/datum/computer_file/program/ntnetdownload/ipc_os/hub = locate() in device.stored_files
	TEST_ASSERT_NOTNULL(hub, "Native NT Software Hub was not installed.")
	TEST_ASSERT_EQUAL(os.pda_job_title, scientist.title, "The initial scientist profession was not captured.")
	TEST_ASSERT(ACCESS_RESEARCH in device.GetAccess(), "Scientist application access is missing: [json_encode(device.GetAccess())].")
	var/datum/computer_file/program/catalog_science = SSmodular_computers.find_ntnet_file_by_name("experi_track")
	TEST_ASSERT_NOTNULL(catalog_science, "Native science software is missing from the station repository.")
	TEST_ASSERT(hub.check_compatibility(catalog_science), "Native science software is not compatible with this Digital PDA.")
	TEST_ASSERT(catalog_science.can_run(ipc, downloading = TRUE, access = device.GetAccess()), "Native science download permission rejected scientist access.")
	TEST_ASSERT(device.can_store_file(catalog_science), "Digital PDA storage rejected the permitted science program.")
	hub.begin_file_download("experi_track", ipc)
	TEST_ASSERT_NOTNULL(hub.downloaded_file, "Scientist could not start downloading the native science program.")
	hub.complete_file_download()
	var/datum/computer_file/program/science/science = device.find_file_by_name("experi_track")
	TEST_ASSERT_NOTNULL(science, "Downloaded program was not saved on the real PDA drive.")
	TEST_ASSERT(science.can_run(ipc), "Installed science program could not use internal job access.")
	var/list/original_access = device.GetAccess()
	os.capture_pda_job(SSjob.get_job_type(/datum/job/captain))
	TEST_ASSERT_EQUAL(os.pda_job_title, scientist.title, "Later role change rewrote the initial profession.")
	TEST_ASSERT_EQUAL(length(device.GetAccess() - original_access), 0, "Later role change granted new application access.")
	for(var/blocked_type in list(/datum/computer_file/program/faxbond, /datum/computer_file/program/nt_pay, /datum/computer_file/program/raptordex, /datum/computer_file/program/card_mod, /datum/computer_file/program/signal_commander, /datum/computer_file/program/betting, /datum/computer_file/program/secureye, /datum/computer_file/program/power_monitor, /datum/computer_file/program/bounty_board, /datum/computer_file/program/coupon, /datum/computer_file/program/shipping, /datum/computer_file/program/ai_restorer))
		var/datum/computer_file/program/blocked = allocate(blocked_type)
		TEST_ASSERT(!device.can_store_file(blocked), "Forbidden software [blocked.filename] could be copied into Digital PDA.")
		TEST_ASSERT(!hub.begin_file_download(blocked.filename, ipc), "Forbidden software [blocked.filename] could be downloaded.")
		var/list/catalog = hub.ui_data(ipc)
		for(var/list/row as anything in catalog["programs"])
			TEST_ASSERT(row["filename"] != blocked.filename, "Forbidden software remained visible in the native store.")
	// An ordinary uncredentialed PDA must still fail the same native execution check.
	var/obj/item/modular_computer/pda/ordinary = allocate(/obj/item/modular_computer/pda)
	var/datum/computer_file/program/science/uncredentialed = allocate(/datum/computer_file/program/science)
	TEST_ASSERT(ordinary.store_file(uncredentialed), "Could not install the ordinary PDA permission fixture.")
	TEST_ASSERT(!uncredentialed.can_run(ipc), "Internal access fallback changed ordinary PDA permissions.")

/// A real processing download reserves one request and installs only after its progress completes.
/datum/unit_test/ipc_os_download_progress/Run()
	var/mob/living/carbon/human/ipc = allocate(/mob/living/carbon/human/consistent)
	ipc.set_species(/datum/species/ipc)
	ipc.mock_client = new /datum/client_interface()
	var/datum/ipc_os/os = ipc.get_ipc_os()
	var/datum/ipc_os_program/signaler = os.programs["signal_boost"]
	TEST_ASSERT(os.begin_download("signal_boost"), "NET refused a valid download.")
	TEST_ASSERT(!os.begin_download("pda"), "Parallel NET downloads were accepted.")
	TEST_ASSERT(!signaler.installed && os.used_storage() == 0, "Download installed software before completion.")
	var/started = world.time
	var/deadline = world.time + 7 SECONDS
	while(os.downloading && os.download_elapsed < 1 && world.time < deadline)
		sleep(1)
	var/list/data = os.ui_data(ipc)
	TEST_ASSERT(data["download_progress"] > 0 && data["download_progress"] < 1, "NET did not expose partial download progress.")
	while(os.downloading && world.time < deadline)
		sleep(1)
	TEST_ASSERT(signaler.installed && os.used_storage() == 5, "Completed NET download did not install the selected program.")
	TEST_ASSERT(world.time >= started + 5 SECONDS, "Five GB downloaded faster than one GB per second.")
	TEST_ASSERT(os.begin_download("pda"), "Could not begin a second sequential download.")
	os.cancel_download()
	TEST_ASSERT_NULL(os.downloading, "Cancel retained a pending download.")
	TEST_ASSERT_EQUAL(os.used_storage(), 5, "Cancellation consumed installable storage.")
	TEST_ASSERT(os.begin_download("pda"), "Could not restart a canceled download.")
	SEND_SIGNAL(ipc, COMSIG_MOB_LOGOUT)
	TEST_ASSERT_NULL(os.downloading, "Disconnect retained a background download.")

/// The HUD action recovers paralysis/stamcrit and cannot wake a sleeper or remove unrelated knockdown.
/datum/unit_test/ipc_os_neural_crack_extended/Run()
	var/mob/living/carbon/human/ipc = allocate(/mob/living/carbon/human/consistent)
	ipc.set_species(/datum/species/ipc)
	ipc.mock_client = new /datum/client_interface()
	var/datum/ipc_os/os = ipc.get_ipc_os()
	os.unlock(TRUE)
	os.install("neural_crack")
	var/datum/ipc_os_program/neural_crack/program = os.programs["neural_crack"]
	TEST_ASSERT(!os.neural_crack(), "NeuralCrack charged without an eligible effect.")
	ipc.Stun(10 SECONDS, ignore_canstun = TRUE)
	ipc.Sleeping(10 SECONDS)
	TEST_ASSERT(!program.crack_action.IsAvailable(), "A sleeping owner could activate NeuralCrack.")
	TEST_ASSERT(!os.neural_crack(), "NeuralCrack woke a sleeping owner.")
	TEST_ASSERT_EQUAL(os.core.damage, 0, "Rejected sleep recovery still charged brain damage.")
	ipc.SetSleeping(0)
	ipc.SetStun(0)
	ipc.Paralyze(10 SECONDS, ignore_canstun = TRUE)
	TEST_ASSERT(program.crack_action.Trigger(ipc), "HUD action was blocked by paralysis.")
	TEST_ASSERT(!ipc.IsParalyzed(), "HUD action retained paralysis.")
	var/started = world.time
	ipc.Paralyze(30 SECONDS, ignore_canstun = TRUE)
	TEST_ASSERT(!program.crack_action.IsAvailable(), "HUD ignored NeuralCrack cooldown.")
	TEST_ASSERT(!os.neural_crack(), "Direct activation bypassed NeuralCrack cooldown.")
	TEST_ASSERT_EQUAL(os.core.damage, 30, "Cooldown rejection charged brain damage.")
	os.uninstall("neural_crack")
	os.install("neural_crack")
	TEST_ASSERT(!program.crack_action.IsAvailable(), "Reinstalling bypassed NeuralCrack cooldown.")
	var/deadline = started + 33 SECONDS
	while(!program.crack_action.IsAvailable() && world.time < deadline)
		sleep(1)
	TEST_ASSERT(world.time >= started + 30 SECONDS, "NeuralCrack became available before 30 seconds.")
	TEST_ASSERT(program.crack_action.IsAvailable(), "NeuralCrack did not become available after cooldown.")
	ipc.adjust_stamina_loss(ipc.maxHealth)
	TEST_ASSERT(ipc.has_status_effect(/datum/status_effect/incapacitating/stamcrit), "Fixture did not enter native stamina crit.")
	TEST_ASSERT(os.can_view(ipc) && !os.can_use(ipc), "Incapacitated OS access did not isolate NeuralCrack.")
	TEST_ASSERT(program.crack_action.Trigger(ipc), "HUD action was blocked by stamina crit.")
	TEST_ASSERT_EQUAL(ipc.get_stamina_loss(), 0, "Stamina crit recovery retained stamina damage.")
	TEST_ASSERT(!ipc.has_status_effect(/datum/status_effect/incapacitating/stamcrit), "Stamina crit effect remained after recovery.")
	TEST_ASSERT_EQUAL(os.core.damage, 60, "Second recovery did not charge exactly another 30 brain damage.")

/// Diagnostics run on real timers, survive walking and cannot survive logout or extraction.
/datum/unit_test/ipc_os_timed_diagnostics/Run()
	var/mob/living/carbon/human/ipc = allocate(/mob/living/carbon/human/consistent)
	ipc.set_species(/datum/species/ipc)
	ipc.mock_client = new /datum/client_interface()
	var/datum/ipc_os/os = ipc.get_ipc_os()
	os.infect("display_glitch", os.core)
	os.infect("sensor_noise", os.core)
	var/datum/ipc_os_malware/display_glitch/glitch = os.infections["display_glitch"]
	var/datum/ipc_os_malware/noise = os.infections["sensor_noise"]
	TEST_ASSERT(os.begin_cure("display_glitch") && os.begin_cure("sensor_noise"), "Diagnostics could not begin background cleanup.")
	TEST_ASSERT(!os.begin_cure("display_glitch"), "A duplicate request restarted the cleaning timer.")
	glitch.finish_cleaning()
	TEST_ASSERT(os.infections["display_glitch"], "An early completion callback skipped the cleaning duration.")
	var/started = world.time
	var/turf/original = get_turf(ipc)
	TEST_ASSERT(ipc.Move(get_step(original, EAST)), "The fixture could not move during cleanup.")
	TEST_ASSERT(glitch.clean_timer && noise.clean_timer, "Movement canceled background cleanup.")
	var/list/data = os.ui_data(ipc)
	for(var/list/infection as anything in data["malware"])
		TEST_ASSERT(infection["cleaning"], "Diagnostics did not expose an active loading indicator.")
		TEST_ASSERT(infection["clean_seconds"] > 0, "Diagnostics did not expose remaining time.")
	var/deadline = started + 65 SECONDS
	while(os.infections["display_glitch"] && world.time < deadline)
		sleep(1)
	TEST_ASSERT(world.time >= started + 30 SECONDS, "DisplayGlitch was cleaned before 30 seconds.")
	TEST_ASSERT(!os.infections["display_glitch"], "DisplayGlitch did not finish cleaning.")
	TEST_ASSERT(os.infections["sensor_noise"], "SensorNoise inherited the shorter DisplayGlitch cleanup.")
	while(os.infections["sensor_noise"] && world.time < deadline)
		sleep(1)
	TEST_ASSERT(world.time >= started + 60 SECONDS, "SensorNoise was cleaned before 60 seconds.")
	TEST_ASSERT(!os.infections["sensor_noise"], "SensorNoise did not finish cleaning.")
	os.infect("display_glitch", os.core)
	glitch = os.infections["display_glitch"]
	TEST_ASSERT(os.begin_cure("display_glitch"), "Could not start the cleanup cancellation fixture.")
	SEND_SIGNAL(ipc, COMSIG_MOB_LOGOUT)
	TEST_ASSERT_NULL(glitch.clean_timer, "Logout retained a cleanup callback.")
	TEST_ASSERT(os.infections["display_glitch"], "Canceled cleanup removed the infection.")
	TEST_ASSERT(os.begin_cure("display_glitch"), "Could not restart a canceled cleanup.")
	var/obj/item/organ/brain/core = os.core
	allocated += core
	core.Remove(ipc, special = TRUE)
	TEST_ASSERT_NULL(glitch.clean_timer, "Brain extraction retained a cleanup callback.")
	TEST_ASSERT(os.infections["display_glitch"], "Positronic extraction erased an unfinished infection.")
