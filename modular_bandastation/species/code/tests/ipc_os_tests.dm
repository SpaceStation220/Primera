/// Installation is a non-yielding server transaction, independent of execution state.
/datum/unit_test/ipc_os_storage/Run()
	var/obj/item/organ/brain/ipc/core = allocate(/obj/item/organ/brain/ipc)
	var/datum/ipc_os/os = core.operating_system
	TEST_ASSERT(os.install("defrag"), "Could not install a legal application.")
	TEST_ASSERT(os.install("power_save"), "Could not install within 24 GB.")
	TEST_ASSERT(!os.install("firewall"), "Storage exceeded 24 GB.")
	TEST_ASSERT(!os.install("defrag"), "Duplicate install succeeded.")
	TEST_ASSERT(!os.install("nonexistent"), "Arbitrary program identifier was accepted.")
	TEST_ASSERT_EQUAL(os.used_storage(), 19, "Stopped installed software uses incorrect capacity.")
	TEST_ASSERT(os.uninstall("defrag"), "Uninstall failed.")
	TEST_ASSERT_EQUAL(os.used_storage(), 9, "Uninstall did not free exact size.")
	TEST_ASSERT(!os.uninstall("defrag"), "Duplicate removal succeeded.")
	TEST_ASSERT(!os.install("overclock"), "Locked illegal software was installed.")
	TEST_ASSERT(os.unlock(), "Limited upgrade failed.")
	TEST_ASSERT(os.install("virus_kit"), "Limited upgrade did not unlock VirusKit.")
	TEST_ASSERT(!os.install("overclock"), "Limited upgrade unlocked OverClock.")
	TEST_ASSERT_EQUAL(os.capacity(), 24, "Limited upgrade increased storage.")
	TEST_ASSERT(os.unlock(TRUE), "EMAG did not escalate limited access.")
	TEST_ASSERT(os.install("overclock"), "EMAG did not unlock OverClock.")
	TEST_ASSERT_EQUAL(os.capacity(), 32, "EMAG did not give exactly 32 GB.")
	TEST_ASSERT(!os.unlock(TRUE), "Repeated EMAG was not idempotent.")
	TEST_ASSERT(!os.unlock(), "Limited upgrade downgraded EMAG access.")
	TEST_ASSERT_EQUAL(os.capacity(), 32, "Repeated upgrades changed capacity.")

/// Extracting a personality retains storage but removes OS actions and effects from its old chassis.
/datum/unit_test/ipc_os_transplant/Run()
	var/mob/living/carbon/human/ipc = allocate(/mob/living/carbon/human/consistent)
	ipc.set_species(/datum/species/ipc)
	var/obj/item/organ/brain/ipc/core = ipc.get_organ_slot(ORGAN_SLOT_BRAIN)
	var/datum/ipc_os/os = core.operating_system
	TEST_ASSERT_EQUAL(os.host, ipc, "New IPC did not bind its OS.")
	TEST_ASSERT(os.open_action in ipc.actions, "IPC was not granted its desktop action.")
	os.install("defrag")
	core.Remove(ipc, special = TRUE)
	TEST_ASSERT_NULL(os.host, "Extracted core retained a chassis reference.")
	TEST_ASSERT_NULL(os.open_action, "Extracted core left a desktop action.")
	TEST_ASSERT_EQUAL(os.used_storage(), 10, "Extraction erased installed software.")
	core.Insert(ipc, special = TRUE)
	TEST_ASSERT_EQUAL(os.host, ipc, "Reinsertion did not bind the OS.")
	ipc.set_species(/datum/species/human)
	TEST_ASSERT_NULL(os.host, "Species loss retained the OS binding.")
