/// Installation is a non-yielding server transaction, independent of execution state.
/datum/unit_test/ipc_os_storage/Run()
	var/obj/item/organ/brain/ipc/core = allocate(/obj/item/organ/brain/ipc)
	var/datum/ipc_os/os = core.operating_system
	TEST_ASSERT(os.install("defrag"), "Could not install a legal application.")
	TEST_ASSERT(os.install("power_save"), "Could not install within 24 GB.")
	TEST_ASSERT(!os.install("firewall"), "Storage exceeded 24 GB.")
	TEST_ASSERT(!os.install("defrag"), "Duplicate install succeeded.")
	TEST_ASSERT(!os.install("nonexistent"), "Arbitrary program identifier was accepted.")
	TEST_ASSERT_EQUAL(os.used_storage(), 19, "Stopped installed software uses incorrect capacity.")
	TEST_ASSERT(os.uninstall("defrag"), "Uninstall failed.")
	TEST_ASSERT_EQUAL(os.used_storage(), 9, "Uninstall did not free exact size.")
	TEST_ASSERT(!os.uninstall("defrag"), "Duplicate removal succeeded.")
	TEST_ASSERT(!os.install("overclock"), "Locked illegal software was installed.")
	TEST_ASSERT(os.unlock(), "Limited upgrade failed.")
	TEST_ASSERT(os.install("virus_kit"), "Limited upgrade did not unlock VirusKit.")
	TEST_ASSERT(!os.install("overclock"), "Limited upgrade unlocked OverClock.")
	TEST_ASSERT_EQUAL(os.capacity(), 24, "Limited upgrade increased storage.")
	TEST_ASSERT(os.unlock(TRUE), "EMAG did not escalate limited access.")
	TEST_ASSERT(os.install("overclock"), "EMAG did not unlock OverClock.")
	TEST_ASSERT_EQUAL(os.capacity(), 32, "EMAG did not give exactly 32 GB.")
	TEST_ASSERT(!os.unlock(TRUE), "Repeated EMAG was not idempotent.")
	TEST_ASSERT(!os.unlock(), "Limited upgrade downgraded EMAG access.")
	TEST_ASSERT_EQUAL(os.capacity(), 32, "Repeated upgrades changed capacity.")

/// Extracting a personality retains storage but removes OS actions and effects from its old chassis.
/datum/unit_test/ipc_os_transplant/Run()
	var/mob/living/carbon/human/ipc = allocate(/mob/living/carbon/human/consistent)
	ipc.set_species(/datum/species/ipc)
	var/obj/item/organ/brain/ipc/core = ipc.get_organ_slot(ORGAN_SLOT_BRAIN)
	var/datum/ipc_os/os = core.operating_system
	TEST_ASSERT_EQUAL(os.host, ipc, "New IPC did not bind its OS.")
	TEST_ASSERT(os.open_action in ipc.actions, "IPC was not granted its desktop action.")
	os.install("defrag")
	os.unlock(TRUE)
	os.infect("display_glitch", core)
	core.Remove(ipc, special = TRUE)
	TEST_ASSERT_NULL(os.host, "Extracted core retained a chassis reference.")
	TEST_ASSERT_NULL(os.open_action, "Extracted core left a desktop action.")
	TEST_ASSERT_EQUAL(os.used_storage(), 10, "Extraction erased installed software.")
	TEST_ASSERT(os.emag_unlocked && os.infections["display_glitch"], "Positronic extraction erased licenses or infections.")
	core.Insert(ipc, special = TRUE)
	TEST_ASSERT_EQUAL(os.host, ipc, "Reinsertion did not bind the OS.")
	ipc.set_species(/datum/species/human)
	TEST_ASSERT_NULL(os.host, "Species loss retained the OS binding.")

/// Organic brains run the same OS in an IPC, but physical extraction erases all software state.
/datum/unit_test/ipc_os_organic_brain/Run()
	var/mob/living/carbon/human/donor = allocate(/mob/living/carbon/human/consistent)
	donor.mind_initialize()
	var/obj/item/organ/brain/brain = donor.get_organ_slot(ORGAN_SLOT_BRAIN)
	allocated += brain
	TEST_ASSERT_NULL(brain.operating_system, "An ordinary human brain acquired IPC software.")
	brain.Remove(donor)
	var/mob/living/carbon/human/ipc = allocate(/mob/living/carbon/human, run_loc_floor_bottom_left, /datum/species/ipc)
	TEST_ASSERT(brain.Insert(ipc, special = TRUE, movement_flags = DELETE_IF_REPLACED), "Organic brain transplant failed.")
	ipc.mock_client = new /datum/client_interface()
	var/datum/ipc_os/os = ipc.get_ipc_os()
	TEST_ASSERT_NOTNULL(os, "An organic brain in an IPC did not acquire an OS.")
	TEST_ASSERT_EQUAL(os.core, brain, "Organic OS does not belong to the transplanted brain.")
	TEST_ASSERT(os.is_operational(), "Organic OS could not use the chassis battery.")
	os.unlock(TRUE)
	os.install("neural_crack")
	var/brain_before = brain.damage
	var/obj/item/bodypart/chest = ipc.get_bodypart(BODY_ZONE_CHEST)
	var/burn_before = chest.burn_dam
	ipc.Stun(10 SECONDS, ignore_canstun = TRUE)
	TEST_ASSERT(os.neural_crack(), "Organic NeuralCrack did not recover stun.")
	TEST_ASSERT_EQUAL(brain.damage, brain_before + 30, "Organic NeuralCrack did not charge the actual organic brain.")
	TEST_ASSERT_EQUAL(chest.burn_dam, burn_before + 15, "Organic NeuralCrack did not burn the chassis torso.")
	TEST_ASSERT(os.infect("core_rot", brain), "Organic OS did not accept a software infection.")
	var/mob/living/carbon/human/surgeon = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/multitool/tool = allocate(/obj/item/multitool)
	var/datum/surgery_operation/organ/repair/brain/mechanic/operation = GLOB.operations.operations_by_typepath[__IMPLIED_TYPE__]
	var/obj/item/bodypart/head = ipc.get_bodypart(BODY_ZONE_HEAD)
	ADD_TRAIT(head, TRAIT_READY_TO_OPERATE, TRAIT_SOURCE_UNIT_TESTS)
	head.add_surgical_state(SURGERY_SKIN_OPEN|SURGERY_BONE_SAWED|SURGERY_VESSELS_CLAMPED)
	TEST_ASSERT(operation.show_as_next_step(ipc, BODY_ZONE_HEAD), "Native neural debugging was unavailable for an infected organic IPC brain.")
	for(var/treatment in 1 to 5)
		UNLINT(operation.success(brain, surgeon, tool, list()))
	TEST_ASSERT(!os.infections["core_rot"], "Five native treatments did not cure the organic OS.")
	os.install("power_save")
	var/datum/ipc_os_program/power_save/program = os.programs["power_save"]
	TEST_ASSERT(program.start(), "Organic PowerSave did not start.")
	os.infect("sensor_noise", brain)
	var/mob/living/carbon/human/attacker = allocate(/mob/living/carbon/human/consistent)
	attacker.set_species(/datum/species/ipc)
	var/datum/ipc_os/attacker_os = attacker.get_ipc_os()
	var/datum/ipc_os_program/virus_kit/kit = attacker_os.programs["virus_kit"]
	kit.hijack_targets += WEAKREF(brain)
	brain.Remove(ipc, special = TRUE)
	TEST_ASSERT_NULL(brain.operating_system, "Organic extraction retained the OS.")
	TEST_ASSERT(QDELETED(os), "Organic extraction did not delete its software state.")
	TEST_ASSERT(!ipc.has_movespeed_modifier(/datum/movespeed_modifier/ipc_os_power_save), "Organic extraction left PowerSave on the chassis.")
	TEST_ASSERT_NULL(ipc.get_ipc_os(), "An empty IPC retained an OS.")
	var/list/attacker_data = attacker_os.ui_data(attacker)
	TEST_ASSERT_EQUAL(length(attacker_data["hijack_targets"]), 0, "Extracted organic brain remained a usable hijack target.")
	TEST_ASSERT_EQUAL(length(kit.hijack_targets), 0, "A target with an erased OS retained a stale control reference.")
	TEST_ASSERT(brain.Insert(donor, special = TRUE), "Organic brain could not return to its original body.")
	TEST_ASSERT_NULL(brain.operating_system, "Extracted software remained active in an ordinary human.")
	var/obj/item/bodypart/donor_head = donor.get_bodypart(BODY_ZONE_HEAD)
	ADD_TRAIT(donor_head, TRAIT_READY_TO_OPERATE, TRAIT_SOURCE_UNIT_TESTS)
	donor_head.add_surgical_state(SURGERY_SKIN_OPEN|SURGERY_BONE_SAWED|SURGERY_VESSELS_CLAMPED)
	TEST_ASSERT(!operation.show_as_next_step(donor, BODY_ZONE_HEAD), "IPC debugging became available for an ordinary organic human brain.")
	brain.Remove(donor, special = TRUE)
	TEST_ASSERT(brain.Insert(ipc, special = TRUE), "Organic brain could not return to the IPC.")
	var/datum/ipc_os/fresh_os = ipc.get_ipc_os()
	TEST_ASSERT_NOTNULL(fresh_os, "Reinserted organic brain did not get a fresh OS.")
	TEST_ASSERT_EQUAL(fresh_os.used_storage(), 0, "Organic reinsertion restored erased programs.")
	TEST_ASSERT_EQUAL(fresh_os.capacity(), 24, "Organic reinsertion restored an erased EMAG unlock.")
	TEST_ASSERT_EQUAL(length(fresh_os.infections), 0, "Organic reinsertion restored erased viruses.")
	TEST_ASSERT_NULL(fresh_os.neural_crack_timer, "Organic reinsertion restored an erased cooldown timer.")
