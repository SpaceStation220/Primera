/**
 * Validate and strip ancillary metadata before pixel decoding and PNG normalization.
 * The temporary path is generated by the caller, never taken from player input.
 */
/proc/read_book_png(upload, temporary_path)
	if(!isfile(upload) || !endswith(lowertext("[upload]"), ".png"))
		return list("error" = "Select a PNG file.")
	if(!length(upload) || length(upload) > MAX_BOOK_PNG_BYTES)
		return list("error" = "PNG files must not exceed 128 KiB.")
	if(!fcopy(upload, temporary_path))
		fdel(temporary_path)
		return list("error" = "The PNG could not be read.")
	var/error
	var/photo
	try
		var/encoded = rustg_hash_file(RUSTG_HASH_BASE64, temporary_path)
		var/list/retained = list(list(1, 9))
		error = book_png_error(encoded, retained)
		if(!error && length(retained) > 1)
			encoded = book_png_without_metadata(encoded, retained)
			rustutils_file_write_b64decode(encoded, temporary_path)
			if(rustg_hash_file(RUSTG_HASH_BASE64, temporary_path) != encoded)
				error = "The PNG could not be prepared for decoding."
		if(!error)
			var/decode_error = rustg_dmi_strip_metadata(temporary_path)
			if(length(decode_error))
				error = "The PNG is damaged or cannot be decoded."
			else
				photo = rustg_hash_file(RUSTG_HASH_BASE64, temporary_path)
				if(!valid_paper_photo(photo))
					error = "The normalized PNG exceeds 128 KiB."
	catch
		error = "The PNG is damaged or cannot be decoded."
	fdel(temporary_path)
	return error ? list("error" = error) : list("photo" = photo)

/**
 * Read bounded PNG structure without inflating IDAT or compressed text.
 * Collect critical chunks and transparency so metadata never reaches the decoder.
 * Ranges are byte offsets with exclusive ends; adjacent retained chunks are merged.
 */
/proc/book_png_error(encoded, list/retained)
	if(!valid_paper_photo(encoded) || copytext(encoded, 1, 23) != "iVBORw0KGgoAAAANSUhEUg")
		return "The file is not a valid PNG."
	var/bytes = length(encoded) / 4 * 3
	if(endswith(encoded, "=="))
		bytes -= 2
	else if(endswith(encoded, "="))
		bytes--
	var/position = 9
	var/chunks = 0
	var/has_pixels = FALSE
	while(position + 11 <= bytes)
		if(++chunks > MAX_BOOK_PNG_CHUNKS)
			return "The PNG contains too many chunks. Export a simpler PNG."
		var/chunk_length = book_png_uint32(encoded, position)
		if(chunk_length < 0 || position + chunk_length + 11 > bytes)
			return "The PNG has an invalid chunk length."
		var/chunk_type = ""
		for(var/index in position + 4 to position + 7)
			chunk_type += ascii2text(book_png_byte(encoded, index))
		if(position == 9)
			var/width = book_png_uint32(encoded, position + 8)
			var/height = book_png_uint32(encoded, position + 12)
			if(width < 1 || height < 1 || width > MAX_BOOK_PNG_DIMENSION || height > MAX_BOOK_PNG_DIMENSION)
				return "PNG dimensions must not exceed 300x300 pixels."
		else if(chunk_type == "IHDR")
			return "The PNG contains a repeated header."
		if(chunk_type in list("acTL", "fcTL", "fdAT"))
			return "Animated PNGs are not supported. Use a static PNG."
		if(!(text2ascii(chunk_type) & 32) || chunk_type == "tRNS")
			var/list/last = retained[length(retained)]
			if(last[2] == position)
				last[2] = position + chunk_length + 12
			else
				retained += list(list(position, position + chunk_length + 12))
		if(chunk_type == "IDAT")
			has_pixels = TRUE
		if(chunk_type == "IEND")
			if(chunk_length || !has_pixels || position + 11 != bytes)
				return "The PNG has an invalid ending."
			return null
		position += chunk_length + 12
	return "The PNG is incomplete."

/// Repack bounded byte ranges into Base64 without decoding metadata or binary DM strings.
/proc/book_png_without_metadata(encoded, list/retained)
	var/static/alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
	var/list/parts = list()
	var/bits = 0
	var/remaining = 0
	for(var/list/segment as anything in retained)
		for(var/position in segment[1] to segment[2] - 1)
			bits = (bits << 8)|book_png_byte(encoded, position)
			remaining += 8
			while(remaining >= 6)
				remaining -= 6
				var/index = ((bits >> remaining) & 63) + 1
				parts += copytext(alphabet, index, index + 1)
			bits &= (1 << remaining) - 1
	if(remaining)
		var/index = (bits << (6 - remaining)) + 1
		parts += copytext(alphabet, index, index + 1)
	while(length(parts) % 4)
		parts += "="
	return parts.Join("")

/// Read an unsigned PNG field, rejecting values larger than our entire input budget.
/proc/book_png_uint32(encoded, position)
	var/value = 0
	for(var/index in position to position + 3)
		value = value * 256 + book_png_byte(encoded, index)
		if(value > MAX_BOOK_PNG_BYTES)
			return -1
	return value

/// Read one byte from bounded Base64 without constructing a binary DM string.
/proc/book_png_byte(encoded, position)
	var/static/alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
	var/offset = position - 1
	var/part = offset % 3
	var/first = round(offset / 3) * 4 + part + 1
	var/high = findtextEx(alphabet, copytext(encoded, first, first + 1)) - 1
	var/low = findtextEx(alphabet, copytext(encoded, first + 1, first + 2)) - 1
	if(part == 0)
		return (high << 2)|(low >> 4)
	if(part == 1)
		return ((high & 15) << 4)|(low >> 2)
	return ((high & 3) << 6)|low
