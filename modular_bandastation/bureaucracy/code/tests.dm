/obj/item/paper/bureaucracy_test
	default_raw_text = "Front text"
	can_become_message_in_bottle = FALSE

/// Initial text, copying and persistence must survive side changes, including lazy-list replacement.
/datum/unit_test/bureaucracy_paper_sides/Run()
	var/obj/item/paper/paper = allocate(/obj/item/paper/bureaucracy_test)
	TEST_ASSERT_EQUAL(paper.get_raw_text(), "Front text/", "Initializing page datums discarded existing default text.")
	paper.set_side(2)
	paper.add_raw_text("Back text")
	var/obj/item/stamp/stamp = allocate(/obj/item/stamp/denied)
	var/list/info = stamp.get_writing_implement_details()
	paper.add_stamp(info["stamp_class"], 20, 30, 45, info["stamp_icon_state"], info["stamp_icon"])
	paper.set_side(1)
	TEST_ASSERT_EQUAL(paper.get_raw_text(), "Front text/", "Flipping to the front lost its text.")
	var/obj/item/paper/copied = paper.copy()
	allocated += copied
	copied.set_side(2)
	TEST_ASSERT_EQUAL(copied.get_raw_text(), "Back text/", "The photocopy lost the reverse side.")
	TEST_ASSERT_EQUAL(length(copied.raw_stamp_data), 1, "The photocopy lost reverse-side stamps.")
	copied.clear_paper()
	copied.add_raw_text("Replacement")
	copied.set_side(1)
	copied.set_side(2)
	TEST_ASSERT_EQUAL(copied.get_raw_text(), "Replacement/", "Replacing a lazy list left its page bound to stale contents.")
	paper.set_side(2)
	TEST_ASSERT_EQUAL(paper.get_raw_text(), "Back text/", "Editing the copied page modified the original.")
	var/list/serialized = paper.convert_to_data()
	var/obj/item/paper/restored = allocate(/obj/item/paper)
	restored.write_from_data(serialized)
	TEST_ASSERT_EQUAL(restored.current_side, 2, "Paper persistence did not restore the active side.")
	TEST_ASSERT_EQUAL(restored.get_raw_text(), "Back text/", "Paper persistence lost reverse text.")
	restored.set_side(1)
	TEST_ASSERT_EQUAL(restored.get_raw_text(), "Front text/", "Paper persistence lost front text.")

/// The archive and scan copy must retain boundaries, blank sides, stamps and inline photos.
/datum/unit_test/bureaucracy_book_archive/Run()
	var/obj/item/paper/first = allocate(/obj/item/paper/bureaucracy_test)
	first.set_side(2)
	first.add_raw_text("Reverse")
	var/obj/item/stamp/stamp = allocate(/obj/item/stamp/denied)
	var/list/info = stamp.get_writing_implement_details()
	first.add_stamp(info["stamp_class"], 10, 15, 30, info["stamp_icon_state"], info["stamp_icon"])
	var/obj/item/paper/second = allocate(/obj/item/paper)
	var/photo = icon2base64(icon('icons/obj/service/bureaucracy.dmi', "paper"))
	TEST_ASSERT(valid_paper_photo(photo), "The actual server-generated PNG was rejected.")
	second.front_page.photo = photo
	var/datum/book_info/book = allocate(/datum/book_info, "Title", "Author", "old")
	TEST_ASSERT_EQUAL(book.get_content(), "old", "The legacy constructor did not initialize its first page.")
	TEST_ASSERT(book.set_content_from_sheets(list(first, second)), "Valid physical sheets were rejected.")
	TEST_ASSERT_EQUAL(book.get_title(), "Title", "Setting sheets overwrote the book metadata.")
	TEST_ASSERT_EQUAL(length(book.pages), 4, "Binding removed a blank reverse side or flattened the pages.")
	var/datum/book_info/copied = book.return_copy()
	allocated += copied
	TEST_ASSERT(book.compare(copied), "The scanner copy did not retain the complete document.")
	var/document = book.to_archive()
	copied.current_page_index = 3
	TEST_ASSERT_EQUAL(copied.to_archive(), document, "Reader position changed the saved document.")
	copied.set_page_content(1, "Changed")
	TEST_ASSERT_NOTEQUAL(copied.content, book.content, "Editing a copied book changed its source.")
	var/datum/book_info/restored = allocate(/datum/book_info)
	TEST_ASSERT(restored.load_archive(document), "New archive data could not be loaded.")
	TEST_ASSERT_EQUAL(restored.to_archive(), document, "The archive roundtrip changed page data.")
	var/datum/book_page/image_page = restored.pages[3]
	TEST_ASSERT_EQUAL(image_page.photo, photo, "Archive load lost the original photograph.")
	var/datum/book_page/stamped_page = restored.pages[2]
	TEST_ASSERT_EQUAL(length(stamped_page.stamps), 1, "Archive load lost the reverse-side stamp.")
	TEST_ASSERT(!restored.load_archive(json_encode(list("format" = "ss220-book", "version" = 2, "pages" = list()))), "An unsupported archive version was accepted.")
	TEST_ASSERT_EQUAL(restored.to_archive(), document, "Rejected archive data damaged the existing book.")
	TEST_ASSERT(!valid_paper_photo("https://example.com/image.png"), "A remote URL was accepted as a photo.")
	TEST_ASSERT(restored.load_archive(html_encode("Legacy <b>book</b>")), "Old archive content was rejected.")
	TEST_ASSERT_EQUAL(length(restored.pages), 1, "Legacy content was not internally migrated to one page.")
	TEST_ASSERT_EQUAL(restored.get_content(), "Legacy <b>book</b>", "Legacy migration changed the existing encoding.")

/// Real inventory transfers must not bypass NODROP or destroy papers when stacks merge/collapse.
/datum/unit_test/bureaucracy_stacks/Run()
	var/mob/living/carbon/human/consistent/user = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/paper_stack/stack = allocate(/obj/item/paper_stack)
	var/obj/item/paper/first = allocate(/obj/item/paper/bureaucracy_test)
	var/obj/item/paper/second = allocate(/obj/item/paper)
	TEST_ASSERT(stack.add_sheet(first) && stack.add_sheet(second), "Could not prepare the initial bundle.")
	var/obj/item/paper/held = allocate(/obj/item/paper)
	TEST_ASSERT(user.put_in_active_hand(held), "The actor could not hold a paper sheet.")
	ADD_TRAIT(held, TRAIT_NODROP, TRAIT_SOURCE_UNIT_TESTS)
	TEST_ASSERT_EQUAL(stack.item_interaction(user, held, list()), ITEM_INTERACT_BLOCKING, "Stack insertion bypassed NODROP.")
	TEST_ASSERT_EQUAL(held.loc, user, "Rejected insertion moved the sheet.")
	REMOVE_TRAIT(held, TRAIT_NODROP, TRAIT_SOURCE_UNIT_TESTS)
	TEST_ASSERT_EQUAL(stack.item_interaction(user, held, list()), ITEM_INTERACT_SUCCESS, "A released sheet could not be added.")
	var/obj/item/paper_stack/other = allocate(/obj/item/paper_stack)
	var/obj/item/paper/third = allocate(/obj/item/paper)
	TEST_ASSERT(other.add_sheet(third) && user.put_in_active_hand(other), "Could not prepare the held bundle.")
	TEST_ASSERT_EQUAL(stack.item_interaction(user, other, list()), ITEM_INTERACT_SUCCESS, "Stacks could not merge through item interaction.")
	TEST_ASSERT(QDELETED(other) && third.loc == stack && length(stack.sheets) == 4, "Merging deleted, duplicated or left behind a sheet.")
	stack.eject_sheet(4, user)
	stack.eject_sheet(3, user)
	stack.eject_sheet(2, user)
	TEST_ASSERT(QDELETED(stack) && !QDELETED(first) && first.loc == run_loc_floor_bottom_left, "Collapsing the last bundle destroyed or trapped the remaining sheet.")
	var/obj/item/paper_stack/photos = allocate(/obj/item/paper_stack)
	var/obj/item/paper/blank = allocate(/obj/item/paper)
	TEST_ASSERT(photos.add_sheet(blank), "Could not prepare a photograph bundle.")
	var/datum/picture/picture = allocate(/datum/picture)
	picture.picture_image = icon('icons/obj/service/bureaucracy.dmi', "paper")
	var/obj/item/photo/photo = allocate(/obj/item/photo, null, picture)
	photo.scribble = "Original reverse caption"
	user.drop_all_held_items()
	TEST_ASSERT(user.put_in_active_hand(photo), "Could not hold the original photograph.")
	var/original_image = icon2base64(picture.picture_image)
	TEST_ASSERT_EQUAL(photos.item_interaction(user, photo, list()), ITEM_INTERACT_SUCCESS, "The original photograph could not be inserted.")
	TEST_ASSERT(QDELETED(photo) && length(photos.sheets) == 2, "Photo insertion did not create one real two-sided leaf.")
	var/obj/item/paper/photo_sheet = photos.sheets[2]
	TEST_ASSERT_EQUAL(photo_sheet.front_page.photo, original_image, "Photo insertion did not retain the original PNG.")
	photo_sheet.set_side(2)
	TEST_ASSERT_EQUAL(photo_sheet.get_raw_text(), "Original reverse caption/", "Photo insertion did not preserve the reverse caption on the reverse side.")

/// Exercise the real deferred binder entry point, then the scanner's existing UI action.
/datum/unit_test/bureaucracy_library_chain/Run()
	var/mob/living/carbon/human/consistent/user = allocate(/mob/living/carbon/human/consistent)
	user.lighting_cutoff = LIGHTING_NIGHTVISION_THRESHOLD
	var/obj/machinery/bookbinder/binder = allocate(/obj/machinery/bookbinder)
	var/obj/item/paper_stack/stack = allocate(/obj/item/paper_stack)
	var/obj/item/paper/first = allocate(/obj/item/paper/bureaucracy_test)
	var/obj/item/paper/second = allocate(/obj/item/paper)
	second.add_raw_text("Second sheet")
	TEST_ASSERT(stack.add_sheet(first) && stack.add_sheet(second) && user.put_in_active_hand(stack), "Could not hold the test manuscript.")
	binder.scanned_name = "Binding author"
	binder.prebind_book(user, stack)
	TEST_ASSERT(binder.busy && stack.loc == binder, "The manuscript did not enter the real binding timer.")
	var/deadline = world.time + 10 SECONDS
	UNTIL(!binder.busy || world.time >= deadline)
	TEST_ASSERT(!binder.busy && QDELETED(stack), "The binder did not consume the completed manuscript.")
	var/obj/item/book/book = locate() in run_loc_floor_bottom_left
	TEST_ASSERT(book, "Binding did not produce a physical book.")
	allocated += book
	TEST_ASSERT_EQUAL(length(book.book_data.pages), 4, "The binder flattened the manuscript.")
	var/obj/machinery/libraryscanner/scanner = allocate(/obj/machinery/libraryscanner)
	TEST_ASSERT(user.put_in_active_hand(book), "Could not hold the bound book.")
	TEST_ASSERT_EQUAL(scanner.item_interaction(user, book, list()), ITEM_INTERACT_SUCCESS, "Could not insert the bound book in the scanner.")
	var/datum/tgui/ui = allocate(/datum/tgui, user, scanner, "LibraryScanner")
	scanner.ui_act("scan", list(), ui)
	TEST_ASSERT(scanner.cache && scanner.cache.compare(book.book_data), "Scanning lost text or page boundaries.")
	TEST_ASSERT(!book.tear_sheet(user), "A book could be torn while it remained inside a closed scanner.")
	scanner.ui_act("eject", list(), ui)
	TEST_ASSERT_EQUAL(book.loc, user, "The scanner did not return the physical book.")
	book.book_data.current_page_index = 3
	TEST_ASSERT(book.tear_sheet(user), "A normal book's physical leaf could not be extracted.")
	TEST_ASSERT_EQUAL(length(book.book_data.pages), 2, "Tearing a sheet did not remove its two sides.")
	TEST_ASSERT_EQUAL(length(scanner.cache.pages), 4, "Tearing a scanned book modified the archive cache.")
	book.unique = TRUE
	TEST_ASSERT(!book.tear_sheet(user), "Unique books bypassed tear protection.")
	var/obj/item/paper/blank = allocate(/obj/item/paper)
	blank.forceMove(binder)
	binder.bind_book(blank)
	TEST_ASSERT(!QDELETED(blank) && blank.loc == run_loc_floor_bottom_left, "An empty manuscript was consumed instead of returned.")
	var/obj/item/paper/moved = allocate(/obj/item/paper/bureaucracy_test)
	user.drop_all_held_items()
	TEST_ASSERT(user.put_in_active_hand(moved), "Could not hold the interrupted manuscript.")
	binder.scanned_name = "Interrupted author"
	binder.prebind_book(user, moved)
	TEST_ASSERT(binder.busy, "The interrupted binding timer did not start.")
	moved.forceMove(run_loc_floor_bottom_left)
	deadline = world.time + 10 SECONDS
	UNTIL(!binder.busy || world.time >= deadline)
	TEST_ASSERT(!binder.busy && !QDELETED(moved) && moved.loc == run_loc_floor_bottom_left, "The delayed binder consumed a manuscript that had already been removed.")
