/// Контейнер подавляет оба канала, сохраняя заряд, активацию и свет после открытия.
/datum/unit_test/xenoarchaeology_containment/Run()
	var/obj/machinery/xenoarch_container/container = allocate(__IMPLIED_TYPE__)
	var/obj/machinery/xenoartifact/test_fixture/artifact = allocate(__IMPLIED_TYPE__)
	artifact.random_effects = TRUE
	artifact.first_effect = new /datum/xenoartifact_effect/heal(artifact)
	artifact.secondary_effect = new /datum/xenoartifact_effect/light(artifact)
	for(var/datum/xenoartifact_effect/effect as anything in list(artifact.first_effect, artifact.secondary_effect))
		effect.ToggleActivate(FALSE)
		effect.current_charge = 3
	TEST_ASSERT(container.close_machine(artifact), "Контейнер не принял артефакт")
	TEST_ASSERT_NOTNULL(container.contained_appearance, "В контейнере отсутствует изображение артефакта")
	TEST_ASSERT_EQUAL(container.contained_appearance.icon, artifact.icon, "Контейнер показывает чужую иконку")
	TEST_ASSERT_EQUAL(container.contained_appearance.icon_state, artifact.icon_state, "Контейнер показывает чужую форму артефакта")
	container.update_appearance()
	TEST_ASSERT_EQUAL(length(container.underlays), 1, "Обновления контейнера накапливают изображения")
	TEST_ASSERT(artifact.containment_suppressed, "Артефакт не подавлен")
	TEST_ASSERT_EQUAL(artifact.light_range, 0, "Подавленный свет проходит через контейнер")
	for(var/datum/xenoartifact_effect/effect as anything in list(artifact.first_effect, artifact.secondary_effect))
		TEST_ASSERT(effect.activated && effect.suppressed, "Контейнер потерял активацию или не подавил канал")
		TEST_ASSERT(!effect.try_drain_charge(0), "Подавленный эффект допускает воздействие")
		TEST_ASSERT_EQUAL(effect.process(2), PROCESS_KILL, "Подавленный эффект продолжает обработку")
		TEST_ASSERT_EQUAL(effect.current_charge, 3, "Заряд изменился во время подавления")
	artifact.trigger_effects(artifact.first_effect.trigger)
	TEST_ASSERT(artifact.first_effect.activated, "Триггер изменил состояние внутри камеры")
	container.open_machine()
	TEST_ASSERT_NULL(container.contained_appearance, "После открытия сохранился снимок артефакта")
	TEST_ASSERT_EQUAL(length(container.underlays), 0, "В пустом контейнере осталось изображение")
	TEST_ASSERT_EQUAL(artifact.loc, get_turf(container), "Открытие не освободило находку")
	TEST_ASSERT(!artifact.containment_suppressed, "Открытый контейнер продолжает подавление")
	TEST_ASSERT(artifact.light_range > 0, "После открытия не восстановился свет")
	for(var/datum/xenoartifact_effect/effect as anything in list(artifact.first_effect, artifact.secondary_effect))
		TEST_ASSERT(!effect.suppressed && effect.activated, "После открытия не восстановился канал")
		TEST_ASSERT_EQUAL(effect.current_charge, 3, "Открытие изменило заряд")

/// ЭМИ, отсутствие питания, разрушение и внешнее перемещение не теряют артефакт или состояние.
/datum/unit_test/xenoarchaeology_containment_failures/Run()
	for(var/failure in list("charge", "emp", "damage", "delete", "move"))
		var/obj/machinery/xenoarch_container/container = allocate(__IMPLIED_TYPE__)
		var/obj/machinery/xenoartifact/test_fixture/artifact = allocate(__IMPLIED_TYPE__)
		artifact.random_effects = TRUE
		artifact.first_effect = new /datum/xenoartifact_effect/heal(artifact)
		artifact.first_effect.ToggleActivate(FALSE)
		TEST_ASSERT(container.close_machine(artifact), "Не удалось подготовить аварию [failure]")
		switch(failure)
			if("charge")
				var/obj/item/stock_parts/power_store/cell/cell = container.get_cell()
				cell.charge = container.power_draw
				container.process(2)
				TEST_ASSERT_EQUAL(cell.charge, 0, "Последний неполный заряд не израсходован")
			if("emp")
				container.emp_act(EMP_HEAVY)
			if("damage")
				container.take_damage(container.max_integrity * 10, BRUTE, BULLET)
			if("delete")
				qdel(container)
			if("move")
				artifact.forceMove(get_turf(container))
		TEST_ASSERT(!QDELETED(artifact) && isturf(artifact.loc), "Авария [failure] потеряла находку")
		if(!QDELETED(container))
			TEST_ASSERT_EQUAL(length(container.underlays), 0, "Авария [failure] оставила изображение в пустой камере")
		TEST_ASSERT(!artifact.first_effect.suppressed && artifact.first_effect.activated, "Авария [failure] не восстановила эффект")
		qdel(artifact)
		qdel(container)

/datum/unit_test/xenoarchaeology_containment_loading/Run()
	var/obj/machinery/xenoarch_container/container = allocate(__IMPLIED_TYPE__)
	var/obj/machinery/xenoartifact/test_fixture/artifact = allocate(__IMPLIED_TYPE__)
	var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human/consistent)
	TEST_ASSERT(!container.close_machine(user), "Контейнер принимает живых существ")
	TEST_ASSERT(!container.close_machine(artifact), "Контейнер принимает особые устройства без общего цикла эффектов")
	artifact.random_effects = TRUE
	artifact.anchored = TRUE
	TEST_ASSERT(!container.close_machine(artifact), "Контейнер принимает закреплённый артефакт")
	artifact.anchored = FALSE
	artifact.lab_owner = WEAKREF(user)
	TEST_ASSERT(!container.close_machine(artifact), "Контейнер забирает цель у лаборатории")
	artifact.lab_owner = null
	var/obj/item/stock_parts/power_store/cell/cell = container.get_cell()
	cell.charge = 0
	TEST_ASSERT(!container.close_machine(artifact), "Контейнер закрывается без заряда")
	cell.charge = cell.maxcharge
	container.set_panel_open(TRUE)
	TEST_ASSERT(!container.close_machine(artifact), "Контейнер закрывается с открытой панелью")
	container.set_panel_open(FALSE)
	TEST_ASSERT(container.close_machine(artifact), "Контейнер отклонил допустимую находку")
	container.interact(user)
	TEST_ASSERT_EQUAL(artifact.loc, container, "Персонаж без доступа открыл контейнер")
	var/obj/item/card/id/advanced/card = allocate(__IMPLIED_TYPE__)
	card.access = list(ACCESS_RESEARCH)
	user.equip_to_slot(card, ITEM_SLOT_ID)
	container.interact(user)
	TEST_ASSERT(isturf(artifact.loc), "Научный доступ не позволяет открыть контейнер")
	container.set_panel_open(TRUE)
	container.interact(user)
	TEST_ASSERT_NULL(container.get_cell(), "Не извлечена батарея через сервисную панель")
	TEST_ASSERT(!QDELETED(container), "Извлечение батареи уничтожило контейнер")
	TEST_ASSERT_EQUAL(container.item_interaction(user, cell), ITEM_INTERACT_SUCCESS, "Не вставлена заменённая батарея")
	TEST_ASSERT_EQUAL(container.get_cell(), cell, "Контейнер потерял заменённую батарею")

/datum/unit_test/xenoarchaeology_containment_power/Run()
	var/obj/machinery/xenoarch_container/container = allocate(__IMPLIED_TYPE__)
	var/obj/item/stock_parts/power_store/cell/cell = container.get_cell()
	var/initial_charge = cell.charge
	container.process(2)
	TEST_ASSERT_EQUAL(cell.charge, initial_charge, "Пустой контейнер расходует заряд")
	var/obj/machinery/xenoartifact/test_fixture/artifact = allocate(__IMPLIED_TYPE__)
	artifact.random_effects = TRUE
	TEST_ASSERT(container.close_machine(artifact), "Не начато подавление для проверки питания")
	container.process(1)
	container.process(1)
	var/short_ticks_charge = cell.charge
	cell.charge = initial_charge
	container.process(2)
	TEST_ASSERT_EQUAL(cell.charge, short_ticks_charge, "Расход батареи зависит от длины тика")

/// Настоящие взаимодействия черепа и костей создают один экспонат и не поглощают лишние кости.
/datum/unit_test/xenoarchaeology_fossils/Run()
	for(var/skull_type in list(/obj/item/xenoarch_fossil/skull, /obj/item/xenoarch_fossil/skull/horned))
		var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human/consistent)
		var/obj/item/xenoarch_fossil/skull/skull = allocate(skull_type)
		var/obj/item/xenoarch_fossil/first_bone = allocate(__IMPLIED_TYPE__)
		user.put_in_active_hand(first_bone)
		TEST_ASSERT_EQUAL(skull.item_interaction(user, first_bone), ITEM_INTERACT_SUCCESS, "Не создан каркас скелета")
		var/obj/structure/xenoarch_skeleton/display = skull.loc
		TEST_ASSERT(istype(display), "Череп не оказался в экспонате")
		allocated += display
		TEST_ASSERT(!display.is_complete(), "Одна кость завершила скелет")
		for(var/amount in 2 to 6)
			var/obj/item/xenoarch_fossil/bone = allocate(__IMPLIED_TYPE__)
			user.put_in_active_hand(bone)
			TEST_ASSERT_EQUAL(display.item_interaction(user, bone), ITEM_INTERACT_SUCCESS, "Не добавлена кость [amount]")
		TEST_ASSERT(display.is_complete(), "Шесть костей и череп не завершили экспонат")
		TEST_ASSERT_EQUAL(display.icon_state, "skel", "Собранный скелет не сменил спрайт")
		var/obj/item/xenoarch_fossil/extra_bone = allocate(__IMPLIED_TYPE__)
		user.put_in_active_hand(extra_bone)
		TEST_ASSERT_EQUAL(display.item_interaction(user, extra_bone), ITEM_INTERACT_BLOCKING, "Экспонат принял лишнюю кость")
		TEST_ASSERT(user.is_holding(extra_bone), "Лишняя кость исчезла из руки")
		display.take_damage(display.max_integrity * 10, BRUTE, BULLET)
		TEST_ASSERT(QDELETED(display), "Экспонат не разрушился от урона")
		TEST_ASSERT(!QDELETED(skull) && isturf(skull.loc), "Разрушение уничтожило череп")
		TEST_ASSERT(!QDELETED(first_bone) && isturf(first_bone.loc), "Разрушение уничтожило кость")
		qdel(user)

/datum/unit_test/xenoarchaeology_fossil_loot/Run()
	var/list/animal_loot = /obj/effect/spawner/random/xenoarch/animal::loot
	TEST_ASSERT(/obj/effect/spawner/random/xenoarch/fossil in animal_loot, "Ископаемые не включены в таблицу останков")
	for(var/fossil_type in typesof(/obj/item/xenoarch_fossil))
		var/obj/item/xenoarch_fossil/fossil = allocate(fossil_type)
		TEST_ASSERT(fossil.declent_ru(NOMINATIVE) != fossil.name, "Отсутствует перевод ископаемого [fossil_type]")
		TEST_ASSERT(fossil.icon_state in icon_states(fossil.icon), "Отсутствует спрайт ископаемого [fossil_type]")
