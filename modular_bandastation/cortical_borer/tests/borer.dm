/// Buttons drawn before the role exists must refresh when a player receives the parasite role.
/datum/unit_test/cortical_borer_actions/Run()
	var/mob/living/basic/cortical_borer/borer = allocate(__IMPLIED_TYPE__)
	borer.set_hud_used(new borer.hud_type(borer))
	for(var/datum/action/action as anything in borer.actions)
		action.ShowTo(borer)
	var/atom/movable/screen/movable/action_button/infest_button = borer.infest_action.viewers[borer.hud_used]
	var/atom/movable/screen/movable/action_button/dominate_button = borer.dominate_action.viewers[borer.hud_used]
	TEST_ASSERT(infest_button && dominate_button, "Fixture did not draw parasite buttons")
	TEST_ASSERT_EQUAL(infest_button.color, rgb(128, 0, 0), "Unclaimed parasite should not have available abilities")
	borer.mind_initialize()
	borer.mind.add_antag_datum(/datum/antagonist/cortical_borer)
	// BYOND normalizes an opaque white atom color to null.
	TEST_ASSERT_NULL(infest_button.color, "Infest button stayed red after gaining the role")
	TEST_ASSERT_NULL(dominate_button.color, "Dominate button stayed red after gaining the role")
	borer.dominate_action.StartCooldown()
	TEST_ASSERT_EQUAL(dominate_button.color, rgb(128, 0, 0), "Dominate button did not show its actual cooldown")
	TEST_ASSERT_NULL(infest_button.color, "Dominate cooldown incorrectly disabled infestation")
	for(var/datum/action/action as anything in borer.actions)
		TEST_ASSERT(action.button_icon_state in icon_states(action.button_icon), "Missing sprite for [action.name]")
		TEST_ASSERT(action.background_icon_state in icon_states(action.background_icon), "Missing background for [action.name]")
	TEST_ASSERT(borer.icon_living in icon_states(borer.icon), "Missing living parasite sprite")
	TEST_ASSERT(borer.icon_dead in icon_states(borer.icon), "Missing dead parasite sprite")
	TEST_ASSERT(borer.host_chat_action.button_icon_state in icon_states(borer.host_chat_action.button_icon), "Missing host communication sprite")
	TEST_ASSERT(borer.resist_action.button_icon_state in icon_states(borer.resist_action.button_icon), "Missing resistance sprite")

/// Hiding must place the parasite below a real table and suppress its elevation until toggled off.
/datum/unit_test/cortical_borer_hiding/Run()
	var/mob/living/basic/cortical_borer/borer = allocate(__IMPLIED_TYPE__)
	var/obj/structure/table/table = allocate(__IMPLIED_TYPE__, run_loc_floor_bottom_left)
	var/mob/living/carbon/human/consistent/host = allocate(__IMPLIED_TYPE__)
	borer.mind_initialize()
	borer.mind.add_antag_datum(/datum/antagonist/cortical_borer)
	borer.hide_action.Trigger()
	borer.forceMove(get_turf(table))
	TEST_ASSERT(borer.hide_action.active, "Hide button did not toggle on")
	TEST_ASSERT(borer.layer < table.layer, "Hiding parasite is still above the table")
	TEST_ASSERT(!HAS_TRAIT(borer, TRAIT_MOB_ELEVATED), "Table lifted the hiding parasite onto its top")
	borer.hide_action.Trigger()
	TEST_ASSERT_EQUAL(borer.layer, initial(borer.layer), "Toggling off did not restore the parasite's layer")
	TEST_ASSERT(!HAS_TRAIT(borer, TRAIT_IGNORE_ELEVATION), "Toggling off retained elevation immunity")
	TEST_ASSERT(HAS_TRAIT(borer, TRAIT_MOB_ELEVATED), "Toggling off did not restore table elevation")
	borer.hide_action.Trigger()
	TEST_ASSERT(borer.enter_host(host), "Could not infest while hiding")
	TEST_ASSERT(!borer.hide_action.active, "Infestation left furniture hiding active")
	TEST_ASSERT_NULL(borer.hide_action.owner, "Furniture hiding was granted inside the host")
	TEST_ASSERT(!HAS_TRAIT(borer, TRAIT_IGNORE_ELEVATION), "Infestation retained furniture elevation immunity")
	borer.leave_host()
	TEST_ASSERT_EQUAL(borer.hide_action.owner, borer, "Leaving did not restore the hide button")

/// Only a successful private message from the parasite unlocks the current host's reply action.
/datum/unit_test/cortical_borer_contact/Run()
	var/mob/living/basic/cortical_borer/borer = allocate(__IMPLIED_TYPE__)
	var/mob/living/carbon/human/consistent/host = allocate(__IMPLIED_TYPE__)
	var/mob/living/carbon/human/consistent/next_host = allocate(__IMPLIED_TYPE__)
	borer.mind_initialize()
	host.mind_initialize()
	borer.mind.add_antag_datum(/datum/antagonist/cortical_borer)
	TEST_ASSERT(borer.enter_host(host), "Could not infest before contact checks")
	TEST_ASSERT_NULL(borer.host_chat_action.owner, "Host received reply action before first contact")
	TEST_ASSERT(!borer.can_communicate(host, FALSE), "Host could bypass the first-contact requirement")
	borer.communicate(host, "Premature reply")
	borer.communicate(borer, "Hive message", hive = TRUE)
	borer.communicate(borer, "")
	TEST_ASSERT(!borer.host_contacted, "Host reply, hive message or empty message unlocked contact")
	TEST_ASSERT(borer.assume_control(), "Could not take control before first contact")
	TEST_ASSERT_NULL(borer.host_chat_action.owner, "Taking control unlocked communication without contact")
	TEST_ASSERT(!borer.can_communicate(borer.captive, FALSE), "Captive could bypass the first-contact requirement")
	borer.release_control()
	TEST_ASSERT_NULL(borer.host_chat_action.owner, "Releasing control unlocked communication without contact")
	borer.communicate(borer, "First private message")
	TEST_ASSERT(borer.host_contacted, "Successful private message did not establish contact")
	TEST_ASSERT_EQUAL(borer.host_chat_action.owner, host, "First contact did not grant the host's reply action")
	TEST_ASSERT(borer.can_communicate(host, FALSE), "Contacted host could not reply")
	TEST_ASSERT(borer.assume_control(), "Could not take control after first contact")
	TEST_ASSERT_EQUAL(borer.host_chat_action.owner, borer.captive, "Reply action did not follow the captive mind")
	borer.release_control()
	TEST_ASSERT_EQUAL(borer.host_chat_action.owner, host, "Reply action did not return to the host")
	borer.leave_host()
	TEST_ASSERT(!borer.host_contacted, "First contact persisted after leaving the host")
	TEST_ASSERT_NULL(borer.host_chat_action.owner, "Host retained reply action after parasite left")
	TEST_ASSERT(borer.enter_host(next_host), "Could not infest the next host")
	TEST_ASSERT_NULL(borer.host_chat_action.owner, "New host inherited another host's contact")
	TEST_ASSERT(borer.assume_control(), "Could not take control of next host")
	borer.communicate(next_host, "Contact during control")
	TEST_ASSERT_EQUAL(borer.host_chat_action.owner, borer.captive, "First contact during control did not grant captive reply")
	borer.leave_host()

/// Both identities and pre-existing host roles survive repeated control transitions and forced removal.
/datum/unit_test/cortical_borer_control/Run()
	var/mob/living/basic/cortical_borer/borer = allocate(__IMPLIED_TYPE__)
	var/mob/living/carbon/human/consistent/host = allocate(__IMPLIED_TYPE__)
	borer.mind_initialize()
	host.mind_initialize()
	borer.mind.add_antag_datum(/datum/antagonist/cortical_borer)
	var/datum/mind/parasite_mind = borer.mind
	var/datum/mind/original_mind = host.mind
	original_mind.add_antag_datum(/datum/antagonist/custom)
	TEST_ASSERT(borer.enter_host(host), "Compatible host could not be infected")
	TEST_ASSERT(borer.assume_control(), "Parasite could not assume control")
	TEST_ASSERT_EQUAL(host.mind, parasite_mind, "Parasite mind did not move into host")
	TEST_ASSERT_EQUAL(borer.captive.mind, original_mind, "Original mind was not preserved")
	borer.release_control()
	TEST_ASSERT_EQUAL(host.mind, original_mind, "Host identity was not returned")
	TEST_ASSERT(original_mind.has_antag_datum(/datum/antagonist/custom), "Host's existing antagonist role was lost")
	TEST_ASSERT_EQUAL(borer.mind, parasite_mind, "Parasite identity was not returned")
	TEST_ASSERT_NULL(borer.captive, "Temporary mob survived release")
	TEST_ASSERT(borer.assume_control(), "A second control cycle failed")
	borer.leave_host()
	TEST_ASSERT_EQUAL(host.mind, original_mind, "Forced removal lost host identity")
	TEST_ASSERT_EQUAL(borer.mind, parasite_mind, "Forced removal lost parasite identity")
	TEST_ASSERT_NULL(host.get_cortical_borer(), "Host retained its parasite after removal")
	TEST_ASSERT_EQUAL(host.stat, STABLE, "Exiting killed or incapacitated a healthy host")

/// A mind transfer's logout must not put the empty parasite to sleep or disable its host's panel.
/datum/unit_test/cortical_borer_control_ssd/Run()
	var/mob/living/basic/cortical_borer/borer = allocate(__IMPLIED_TYPE__)
	var/mob/living/carbon/human/consistent/host = allocate(__IMPLIED_TYPE__)
	borer.mind_initialize()
	host.mind_initialize()
	borer.mind.add_antag_datum(/datum/antagonist/cortical_borer)
	TEST_ASSERT(borer.enter_host(host), "Could not infect before SSD check")
	TEST_ASSERT(borer.assume_control(), "Could not take control before SSD check")
	borer.AddElement(/datum/element/ssd)
	SEND_SIGNAL(borer, COMSIG_MOB_LOGOUT)
	TEST_ASSERT(!borer.player_logged, "Fixture did not reproduce the empty body's logout")
	borer.handle_ssd(SSMOBS_DT)
	TEST_ASSERT(!borer.has_status_effect(/datum/status_effect/incapacitating/sleeping), "Empty parasite acquired SSD sleep during control")
	TEST_ASSERT(!IS_UNCONSCIOUS(borer), "Empty parasite was knocked out by SSD handling")
	TEST_ASSERT(borer.can_act(host), "SSD handling blocked the conscious controller's abilities")
	TEST_ASSERT_EQUAL(borer.ui_status(host, GLOB.always_state), UI_INTERACTIVE, "Controller's panel is not interactive")
	var/list/panel_data = borer.ui_data(host)
	TEST_ASSERT(panel_data["can_act"], "Panel data disabled the conscious controller's buttons")
	borer.release_control()
	borer.handle_ssd(SSMOBS_DT)
	TEST_ASSERT(borer.IsSleeping(), "Real logout outside of control no longer applies ordinary SSD sleep")
	borer.leave_host()

/// Only the acting body determines consciousness while controlled; strangers still cannot use the UI.
/datum/unit_test/cortical_borer_control_ui/Run()
	var/mob/living/basic/cortical_borer/borer = allocate(__IMPLIED_TYPE__)
	var/mob/living/carbon/human/consistent/host = allocate(__IMPLIED_TYPE__)
	var/mob/living/carbon/human/consistent/stranger = allocate(__IMPLIED_TYPE__)
	borer.mind_initialize()
	host.mind_initialize()
	borer.mind.add_antag_datum(/datum/antagonist/cortical_borer)
	TEST_ASSERT(borer.enter_host(host), "Could not infect before panel checks")
	TEST_ASSERT(borer.assume_control(), "Could not take control before panel checks")
	borer.SetSleeping(7 SECONDS)
	TEST_ASSERT(IS_UNCONSCIOUS(borer), "Fixture did not put the empty parasite body to sleep")
	TEST_ASSERT(borer.can_act(host), "Sleeping empty body blocked the awake controller")
	TEST_ASSERT_EQUAL(borer.ui_status(host, GLOB.always_state), UI_INTERACTIVE, "Empty body's sleep locked the panel")
	TEST_ASSERT_EQUAL(borer.ui_status(stranger, GLOB.always_state), UI_CLOSE, "Stranger could access the parasite's panel")
	host.SetSleeping(7 SECONDS)
	TEST_ASSERT(!borer.can_act(host), "Sleeping controller could still use abilities")
	TEST_ASSERT_EQUAL(borer.ui_status(host, GLOB.always_state), UI_UPDATE, "Sleeping controller retained an interactive panel")
	borer.leave_host()
	TEST_ASSERT(!borer.can_act(borer), "Sleep stopped restricting the parasite after control ended")

