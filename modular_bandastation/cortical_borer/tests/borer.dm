/// Reproduction must debit once, create one independent child, and reject a second unfunded request.
/datum/unit_test/cortical_borer_reproduction/Run()
	var/mob/living/basic/cortical_borer/borer = allocate(__IMPLIED_TYPE__)
	var/mob/living/carbon/human/consistent/host = allocate(__IMPLIED_TYPE__)
	borer.mind_initialize()
	borer.mind.add_antag_datum(/datum/antagonist/cortical_borer)
	TEST_ASSERT(borer.enter_host(host), "Could not infect before reproduction")
	TEST_ASSERT(borer.assume_control(), "Could not control before reproduction")
	borer.chemicals = 100
	TEST_ASSERT(borer.reproduce(host), "Reproduction failed with sufficient chemicals")
	TEST_ASSERT_EQUAL(borer.chemicals, 0, "Reproduction did not charge exactly 100 chemicals")
	TEST_ASSERT_EQUAL(borer.evolution_points, 1, "Reproduction awarded the wrong number of points")
	var/mob/living/basic/cortical_borer/child = locate() in get_turf(host)
	TEST_ASSERT_NOTNULL(child, "Reproduction did not create a child")
	allocated += child
	TEST_ASSERT_EQUAL(child.generation, 2, "Child generation was not inherited")
	TEST_ASSERT(!borer.reproduce(host), "Repeated request created an unfunded child")
	borer.leave_host()
