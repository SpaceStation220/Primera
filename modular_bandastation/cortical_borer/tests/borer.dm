/// Invalid chemistry, sugar and duplicate infestation must not spend resource or affect the host.
/datum/unit_test/cortical_borer_validation/Run()
	var/mob/living/basic/cortical_borer/borer = allocate(__IMPLIED_TYPE__)
	var/mob/living/basic/cortical_borer/second = allocate(__IMPLIED_TYPE__)
	var/mob/living/carbon/human/consistent/host = allocate(__IMPLIED_TYPE__)
	borer.mind_initialize()
	borer.mind.add_antag_datum(/datum/antagonist/cortical_borer)
	TEST_ASSERT(borer.enter_host(host), "Failed to infect test host")
	TEST_ASSERT(!second.can_infest(host), "A second parasite could infect the same host")
	borer.chemicals = 100
	TEST_ASSERT(!borer.secrete(borer, "/datum/reagent/medicine/adminordrazine"), "Arbitrary reagent path was accepted")
	TEST_ASSERT_EQUAL(borer.chemicals, 100, "Rejected input spent chemicals")
	host.reagents.add_reagent(/datum/reagent/consumable/sugar, 5)
	TEST_ASSERT(!borer.assume_control(), "Sugar did not block control")
	TEST_ASSERT(!borer.secrete(borer, "mannitol"), "Sugar did not block secretion")
	TEST_ASSERT_EQUAL(borer.chemicals, 100, "Suppressed ability spent chemicals")
	host.reagents.remove_reagent(/datum/reagent/consumable/sugar, 5)
	TEST_ASSERT(borer.secrete(borer, "mannitol"), "Valid secretion failed")
	TEST_ASSERT_EQUAL(borer.chemicals, 70, "Valid secretion charged the wrong price")
	TEST_ASSERT(!borer.secrete(borer, "mannitol"), "Repeated request bypassed cooldown")
	borer.leave_host()

/// Returning from a host removes precisely the effects applied to physiology and current arms.
/datum/unit_test/cortical_borer_focus_cleanup/Run()
	var/mob/living/basic/cortical_borer/borer = allocate(__IMPLIED_TYPE__)
	var/mob/living/carbon/human/consistent/host = allocate(__IMPLIED_TYPE__)
	var/initial_brute = GET_PHYSIOLOGY(host, BRUTE)
	var/initial_hunger = GET_PHYSIOLOGY(host, PHYS_COEFF_HUNGER_MOD)
	var/initial_stamina = host.stamina_regen_time
	var/obj/item/bodypart/arm/arm = host.get_bodypart(BODY_ZONE_L_ARM)
	var/initial_low = arm.unarmed_damage_low
	borer.focuses += new /datum/cortical_borer_focus/head
	borer.focuses += new /datum/cortical_borer_focus/torso
	borer.focuses += new /datum/cortical_borer_focus/hands
	borer.focuses += new /datum/cortical_borer_focus/legs
	TEST_ASSERT(borer.enter_host(host), "Failed to attach with focuses")
	borer.leave_host()
	TEST_ASSERT_EQUAL(GET_PHYSIOLOGY(host, BRUTE), initial_brute, "Brute resistance remained after exit")
	TEST_ASSERT_EQUAL(GET_PHYSIOLOGY(host, PHYS_COEFF_HUNGER_MOD), initial_hunger, "Hunger modifier remained after exit")
	TEST_ASSERT_EQUAL(host.stamina_regen_time, initial_stamina, "Stamina modifier remained after exit")
	TEST_ASSERT_EQUAL(arm.unarmed_damage_low, initial_low, "Arm damage remained modified")
	TEST_ASSERT(!HAS_TRAIT(host, TRAIT_STABLEHEART), "Heart protection remained after exit")

/// The brain removal signal returns the original identity before the brain moves it out of the body.
/datum/unit_test/cortical_borer_brain_removal/Run()
	var/mob/living/basic/cortical_borer/borer = allocate(__IMPLIED_TYPE__)
	var/mob/living/carbon/human/consistent/host = allocate(__IMPLIED_TYPE__)
	borer.mind_initialize()
	host.mind_initialize()
	borer.mind.add_antag_datum(/datum/antagonist/cortical_borer)
	var/datum/mind/parasite_mind = borer.mind
	var/datum/mind/original_mind = host.mind
	TEST_ASSERT(borer.enter_host(host), "Failed to infest before brain extraction")
	TEST_ASSERT(borer.assume_control(), "Failed to control before brain extraction")
	var/obj/item/organ/brain/brain = host.get_organ_slot(ORGAN_SLOT_BRAIN)
	brain.Remove(host)
	TEST_ASSERT_NULL(borer.host, "Brain extraction did not remove parasite")
	TEST_ASSERT_EQUAL(borer.mind, parasite_mind, "Parasite mind was stolen by extracted brain")
	TEST_ASSERT_EQUAL(brain.brainmob?.mind, original_mind, "Extracted brain did not receive the host's original identity")

/// Death and sugar restore control immediately; deleting the parasite must leave the host intact.
/datum/unit_test/cortical_borer_emergency_release/Run()
	var/mob/living/basic/cortical_borer/borer = allocate(__IMPLIED_TYPE__)
	var/mob/living/carbon/human/consistent/host = allocate(__IMPLIED_TYPE__)
	borer.mind_initialize()
	host.mind_initialize()
	borer.mind.add_antag_datum(/datum/antagonist/cortical_borer)
	var/datum/mind/original_mind = host.mind
	TEST_ASSERT(borer.enter_host(host), "Could not infect before emergency release")
	TEST_ASSERT(borer.assume_control(), "Could not take control before sugar")
	host.reagents.add_reagent(/datum/reagent/consumable/sugar, 5)
	borer.Life(2)
	TEST_ASSERT(!borer.controlling, "Sugar did not restore control on the next life tick")
	TEST_ASSERT_EQUAL(host.mind, original_mind, "Sugar did not return the original mind")
	host.reagents.remove_reagent(/datum/reagent/consumable/sugar, 5)
	TEST_ASSERT(borer.assume_control(), "Could not retake control after sugar cleared")
	host.death()
	TEST_ASSERT(!borer.controlling, "Host death did not release control")
	TEST_ASSERT_EQUAL(host.mind, original_mind, "Host death lost the original mind")
	TEST_ASSERT(!HAS_TRAIT(host, TRAIT_MIND_TEMPORARILY_GONE), "Host retained temporary possession trait")
	borer.leave_host()
	host.revive(HEAL_ALL)
	TEST_ASSERT(borer.enter_host(host), "Could not infect revived host")
	TEST_ASSERT(borer.assume_control(), "Could not control before parasite deletion")
	qdel(borer)
	TEST_ASSERT_EQUAL(host.mind, original_mind, "Deleting parasite lost the host's mind")
	TEST_ASSERT_EQUAL(host.stat, STABLE, "Deleting parasite harmed a healthy host")
	TEST_ASSERT_NULL(host.get_cortical_borer(), "Deleting parasite left an infestation behind")

