/// Client handoff must not invoke the real SSD sleep/overlay path, without granting sleep immunity.
/datum/unit_test/cyberpsychosis_ssd/Run()
	for(var/effect_type in list(/datum/status_effect/forced_combat/cyberpsychosis, /datum/status_effect/forced_combat/cyberpsychosis/controlled))
		var/mob/living/carbon/human/human = allocate(/mob/living/carbon/human/consistent)
		var/datum/status_effect/forced_combat/cyberpsychosis/episode = human.apply_status_effect(effect_type)
		// Exercise the same Logout that moving the real client to the backseat invokes.
		human.Logout()
		TEST_ASSERT(human.player_logged, "[effect_type]: handoff incorrectly marked the body SSD.")
		TEST_ASSERT(!(GLOB.ssd_indicator_overlay in human.overlays), "[effect_type]: SSD overlay appeared during handoff.")
		var/examine_text = jointext(human.examine(human), "")
		TEST_ASSERT(!findtext(examine_text, "кататонии"), "[effect_type]: examine describes the active body as catatonic.")
		SEND_SIGNAL(human, COMSIG_LIVING_REVIVE)
		TEST_ASSERT(!(GLOB.ssd_indicator_overlay in human.overlays), "[effect_type]: status refresh restored the SSD overlay.")
		human.handle_ssd(2)
		TEST_ASSERT(!human.IsSleeping(), "[effect_type]: SSD processing put the body to sleep.")
		human.SetSleeping(10 SECONDS)
		human.handle_ssd(2)
		TEST_ASSERT_EQUAL(human.AmountSleeping(), 10 SECONDS, "[effect_type]: suppression changed real sleep.")
		human.SetSleeping(0)
		human.Stun(5 SECONDS)
		TEST_ASSERT(human.IsStun(), "[effect_type]: SSD suppression granted stun immunity.")
		human.SetStun(0)
		qdel(episode)
		TEST_ASSERT(!HAS_TRAIT(human, TRAIT_SSD_SUPPRESSED), "SSD suppression leaked after the episode.")
		// This fixture has no real client: after handoff ends it must be genuinely SSD again.
		TEST_ASSERT(!human.player_logged, "A genuinely disconnected body remained exempt after the episode.")
		TEST_ASSERT(GLOB.ssd_indicator_overlay in human.overlays, "Normal SSD indicator did not return.")
		human.handle_ssd(2)
		TEST_ASSERT(human.IsSleeping(), "Normal offline sleep no longer works after the episode.")
		SEND_SIGNAL(human, COMSIG_MOB_LOGIN)
		TEST_ASSERT(human.player_logged, "Reconnecting did not clear normal SSD.")
		TEST_ASSERT(!(GLOB.ssd_indicator_overlay in human.overlays), "Reconnecting left an SSD overlay.")

/// Removing this source must not remove another exemption; pre-existing SSD state must also clear.
/datum/unit_test/cyberpsychosis_ssd_sources/Run()
	var/mob/living/carbon/human/human = allocate(/mob/living/carbon/human/consistent)
	human.Logout()
	TEST_ASSERT(!human.player_logged, "Fixture did not enter real SSD.")
	var/datum/status_effect/forced_combat/cyberpsychosis/episode = human.apply_status_effect(/datum/status_effect/forced_combat/cyberpsychosis)
	TEST_ASSERT(human.player_logged, "Starting an episode did not suppress a pre-existing SSD marker.")
	TEST_ASSERT(!(GLOB.ssd_indicator_overlay in human.overlays), "Starting an episode left the SSD overlay.")
	ADD_TRAIT(human, TRAIT_SSD_SUPPRESSED, TRAIT_SOURCE_UNIT_TESTS)
	qdel(episode)
	TEST_ASSERT(HAS_TRAIT_FROM(human, TRAIT_SSD_SUPPRESSED, TRAIT_SOURCE_UNIT_TESTS), "Episode removed another exemption's source.")
	human.handle_ssd(2)
	TEST_ASSERT(!human.IsSleeping(), "Another exemption's suppression stopped working.")
	REMOVE_TRAIT(human, TRAIT_SSD_SUPPRESSED, TRAIT_SOURCE_UNIT_TESTS)
	TEST_ASSERT(!human.player_logged, "Offline state did not return after the last exemption ended.")
