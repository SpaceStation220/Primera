/// Losing control of the body must preserve already active drug and implant effects.
/datum/unit_test/cyberpsychosis_existing_effects/Run()
	for(var/effect_type in list(/datum/status_effect/forced_combat/cyberpsychosis, /datum/status_effect/forced_combat/cyberpsychosis/controlled))
		var/mob/living/carbon/human/host = allocate(/mob/living/carbon/human/consistent)
		var/obj/item/organ/cyberimp/brain/anti_drop/grip = allocate(/obj/item/organ/cyberimp/brain/anti_drop)
		grip.Insert(host)
		var/obj/item/crowbar/tool = allocate(/obj/item/crowbar)
		host.put_in_active_hand(tool)
		grip.ui_action_click()
		TEST_ASSERT(grip.active && HAS_TRAIT(tool, TRAIT_NODROP), "Anti-drop did not activate before the episode.")
		var/datum/action/cooldown/adrenaline/adrenaline = allocate(/datum/action/cooldown/adrenaline, host)
		adrenaline.Grant(host)
		adrenaline.Activate(host)
		host.reagents.metabolize(host, 2, can_overdose = FALSE)
		TEST_ASSERT(HAS_TRAIT(host, TRAIT_STIMULATED), "Adrenaline's stimulant effect did not start.")
		var/stimulant_before = host.reagents.get_reagent_amount(/datum/reagent/drug/pumpup)
		var/datum/status_effect/forced_combat/cyberpsychosis/episode = host.apply_status_effect(effect_type)
		host.Logout()
		TEST_ASSERT_EQUAL(host.reagents.get_reagent_amount(/datum/reagent/drug/pumpup), stimulant_before, "Handoff removed active adrenaline reagents.")
		TEST_ASSERT(HAS_TRAIT(host, TRAIT_STIMULATED), "Handoff removed the active stimulant effect.")
		TEST_ASSERT(grip.active && HAS_TRAIT(tool, TRAIT_NODROP), "Handoff disabled the active anti-drop implant.")
		TEST_ASSERT_EQUAL(host.get_active_held_item(), tool, "Handoff dropped the held item.")
		host.adjust_brute_loss(25)
		host.reagents.add_reagent(/datum/reagent/medicine/omnizine, 5)
		var/brute_before = host.get_brute_loss()
		host.reagents.metabolize(host, 2, can_overdose = FALSE)
		TEST_ASSERT(host.get_brute_loss() < brute_before, "Medicine did not heal the body during cyberpsychosis.")
		TEST_ASSERT(host.reagents.get_reagent_amount(/datum/reagent/drug/pumpup) < stimulant_before, "Active adrenaline stopped metabolizing.")
		TEST_ASSERT(HAS_TRAIT(host, TRAIT_STIMULATED), "Active stimulant effect stopped during cyberpsychosis.")
		qdel(episode)
		TEST_ASSERT(HAS_TRAIT(host, TRAIT_STIMULATED), "Episode cleanup removed the stimulant effect.")
		TEST_ASSERT(grip.active && HAS_TRAIT(tool, TRAIT_NODROP), "Episode cleanup disabled the active anti-drop implant.")
		grip.ui_action_click()

		var/mob/living/carbon/human/automatic_host = allocate(/mob/living/carbon/human/consistent)
		var/obj/item/organ/cyberimp/brain/anti_stun/cns = allocate(/obj/item/organ/cyberimp/brain/anti_stun)
		cns.Insert(automatic_host)
		episode = automatic_host.apply_status_effect(effect_type)
		automatic_host.Logout()
		automatic_host.Stun(5 SECONDS)
		sleep(2 SECONDS) // CNS's real signal/timer path caps the stun after one second.
		TEST_ASSERT(!automatic_host.IsStun(), "Automatic CNS reboot failed while the client was backseated.")
		TEST_ASSERT(COOLDOWN_STARTED(cns, implant_cooldown), "CNS did not actually trigger its automatic response.")
		TEST_ASSERT(HAS_TRAIT_FROM(automatic_host, TRAIT_STUNIMMUNE, REF(cns)), "CNS resistance was not applied during cyberpsychosis.")
		var/obj/item/organ/cyberimp/chest/pump/centcom/pump = allocate(/obj/item/organ/cyberimp/chest/pump/centcom)
		pump.Insert(automatic_host)
		pump.on_life(2, 1)
		TEST_ASSERT(automatic_host.reagents.has_reagent(/datum/reagent/medicine/syndicate_nanites), "Automatic implant pump stopped injecting during cyberpsychosis.")
		qdel(episode)
		TEST_ASSERT(HAS_TRAIT_FROM(automatic_host, TRAIT_STUNIMMUNE, REF(cns)), "Episode cleanup removed CNS's independent resistance.")
