/// Exercise the purchased injector, manual buttons, shared episode behavior and termination cooldowns.
/datum/unit_test/cyberpsychopath_implant/Run()
	var/datum/uplink_item/implants/cyberpsychopath/product = allocate(/datum/uplink_item/implants/cyberpsychopath)
	TEST_ASSERT_EQUAL(product.name, "Cyberpsychopath", "Incorrect uplink name.")
	TEST_ASSERT_EQUAL(product.cost, 8, "Incorrect uplink price.")
	var/obj/item/implanter/cyberpsychopath/injector = allocate(product.item)
	var/obj/item/implant/cyberpsychopath/implant = injector.imp
	TEST_ASSERT(istype(implant), "Purchased injector does not contain Cyberpsychopath.")
	var/icon/implant_sprite = icon(implant.icon, implant.icon_state)
	TEST_ASSERT_EQUAL(implant_sprite.Width(), 32, "Physical implant sprite must be 32 pixels wide.")
	TEST_ASSERT_EQUAL(implant.icon_state, "implant", "Physical implant is not using the red CNS sprite.")
	TEST_ASSERT(HAS_TRAIT(injector, TRAIT_CONTRABAND) && HAS_TRAIT(implant, TRAIT_CONTRABAND), "Product is not contraband.")
	TEST_ASSERT_EQUAL(implant.cyberpsychosis_load, 0, "Cyberpsychopath must not contribute burden.")
	TEST_ASSERT(!findtext(product.desc, "нагруз") && !findtext(product.desc, "лимит"), "Uplink description discloses burden mechanics.")
	var/mob/living/carbon/human/host = allocate(/mob/living/carbon/human/consistent)
	var/mob/living/carbon/human/stranger = allocate(/mob/living/carbon/human/consistent)
	TEST_ASSERT(implant.implant(host, silent = TRUE, force = TRUE), "Could not install the implant.")
	var/datum/component/cyberpsychosis/load = host.GetComponent(/datum/component/cyberpsychosis)
	TEST_ASSERT_EQUAL(load.load, 0, "Installed burden is incorrect.")
	var/datum/action/item_action/hands_free/cyberpsychopath/toggle = locate() in host.actions
	TEST_ASSERT_NOTNULL(toggle, "Host did not receive the activation button.")
	TEST_ASSERT_EQUAL(toggle.button_icon_state, "action", "Activation button is not using the skull icon.")
	TEST_ASSERT("action" in icon_states(toggle.button_icon), "Skull icon is missing from the action file.")
	TEST_ASSERT(!toggle.Trigger(stranger), "Another mob can activate the host's implant.")
	toggle.Trigger(host)
	var/datum/status_effect/forced_combat/cyberpsychosis/controlled/episode = implant.active_episode_ref?.resolve()
	TEST_ASSERT_NOTNULL(episode, "The activation action did not start cyberpsychosis.")
	TEST_ASSERT_EQUAL(episode.duration, 20 SECONDS, "Controlled episode must last 20 seconds.")
	TEST_ASSERT_EQUAL(episode.nextmove_modifier(), 0.8, "Controlled episode lost attack acceleration.")
	TEST_ASSERT_NULL(load.buildup_timer, "Controlled episode did not pause buildup.")
	TEST_ASSERT(findtext(load.get_scan_report(), "Наблюдается аномалия"), "Scanner missed a controlled episode.")
	var/mob/living/cyberpsychosis_backseat/seat = episode.backseat
	var/datum/action/cyberpsychopath_stop/stop = implant.stop_action
	TEST_ASSERT_EQUAL(stop.button_icon, toggle.button_icon, "Stop button is not using the selected skull icon file.")
	TEST_ASSERT_EQUAL(stop.button_icon_state, "action", "Stop button is not using the skull icon.")
	TEST_ASSERT_EQUAL(stop.owner, seat, "Stop action was not granted to the observer seat.")
	TEST_ASSERT_EQUAL(length(seat.actions), 1, "Other body actions leaked into the observer seat.")
	TEST_ASSERT(!stop.Trigger(stranger), "A stranger can disable this episode.")
	TEST_ASSERT(!stop.Trigger(host), "Body identity can bypass observer ownership checks.")
	TEST_ASSERT(stop.Trigger(seat), "The player cannot disable the episode from the seat.")
	TEST_ASSERT(QDELETED(episode) && QDELETED(seat) && QDELETED(stop), "Manual shutdown leaked effect, seat or button.")
	TEST_ASSERT_EQUAL(COOLDOWN_TIMELEFT(implant, reactivation_cooldown), 20 SECONDS, "Manual shutdown must start a 20 second cooldown.")
	TEST_ASSERT(!implant.activate(), "Implant can reactivate during cooldown.")
	COOLDOWN_RESET(implant, reactivation_cooldown)
	TEST_ASSERT(implant.activate(), "Ready implant could not reactivate.")
	episode = implant.active_episode_ref.resolve()
	episode.process(19)
	TEST_ASSERT(!QDELETED(episode), "Episode ended before 20 seconds.")
	episode.process(1)
	TEST_ASSERT(QDELETED(episode), "Episode did not end at 20 seconds.")
	TEST_ASSERT_EQUAL(host.get_organ_loss(ORGAN_SLOT_BRAIN), 0, "A normal manual episode damaged the brain without an EMP fault.")
	TEST_ASSERT_EQUAL(COOLDOWN_TIMELEFT(implant, reactivation_cooldown), 20 SECONDS, "Automatic shutdown must start cooldown.")
	COOLDOWN_RESET(implant, reactivation_cooldown)
	var/datum/status_effect/forced_combat/cyberpsychosis/natural = host.apply_status_effect(/datum/status_effect/forced_combat/cyberpsychosis)
	TEST_ASSERT_EQUAL(natural.duration, 40 SECONDS, "Natural episodes must last 40 seconds.")
	TEST_ASSERT(!implant.activate(), "Implant took over a natural episode.")
	TEST_ASSERT(!QDELETED(natural), "Implant switched off a natural episode.")
	qdel(natural)
	TEST_ASSERT(implant.activate(), "Could not restart after a natural episode.")
	episode = implant.active_episode_ref.resolve()
	implant.removed(host)
	TEST_ASSERT(QDELETED(episode), "Extraction did not end the implant's episode.")
	TEST_ASSERT_EQUAL(COOLDOWN_TIMELEFT(implant, reactivation_cooldown), 20 SECONDS, "Extraction bypassed cooldown.")
	implant.implant(host, silent = TRUE, force = TRUE)
	TEST_ASSERT(!implant.activate(), "Reimplanting reset cooldown.")
	COOLDOWN_RESET(implant, reactivation_cooldown)
	implant.activate()
	episode = implant.active_episode_ref.resolve()
	implant.set_cybernetic_rejection(TRUE)
	TEST_ASSERT(QDELETED(episode), "Rejection did not stop the controlled episode.")
	TEST_ASSERT(!implant.activate(), "Rejected hardware can activate.")
	implant.set_cybernetic_rejection(FALSE)
	COOLDOWN_RESET(implant, reactivation_cooldown)
	implant.activate()
	episode = implant.active_episode_ref.resolve()
	host.death()
	TEST_ASSERT(QDELETED(episode), "Death did not stop the controlled episode.")
	TEST_ASSERT_EQUAL(COOLDOWN_TIMELEFT(implant, reactivation_cooldown), 20 SECONDS, "Death bypassed cooldown.")
	TEST_ASSERT(!implant.activate(), "Dead host can activate the implant.")
	host.revive(ADMIN_HEAL_ALL)
	TEST_ASSERT(!implant.activate(), "Revival reset the implant's cooldown.")
	COOLDOWN_RESET(implant, reactivation_cooldown)
	implant.activate()
	episode = implant.active_episode_ref.resolve()
	qdel(implant)
	TEST_ASSERT(QDELETED(episode), "Deleting the implant leaked its controlled episode.")

/// Keyboard dispatch omits clicker and must keep the same binding across the control handoff.
/datum/unit_test/cyberpsychopath_hotkey/Run()
	var/mob/living/carbon/human/host = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/implant/cyberpsychopath/implant = allocate(/obj/item/implant/cyberpsychopath)
	implant.implant(host, silent = TRUE, force = TRUE)
	var/datum/action/item_action/hands_free/cyberpsychopath/toggle = locate() in host.actions
	TEST_ASSERT_NOTNULL(toggle, "The implant did not grant its action.")
	toggle.set_key("F6")
	// Exercise the real signal dispatched by mob.key_down, not Trigger with an explicit clicker.
	SEND_SIGNAL(host, COMSIG_MOB_KEYDOWN, "F7", null, "F7")
	TEST_ASSERT(!host.has_status_effect(/datum/status_effect/forced_combat/cyberpsychosis), "An unrelated key activated the implant.")
	toggle.action_disabled = TRUE
	SEND_SIGNAL(host, COMSIG_MOB_KEYDOWN, "F6", null, "F6")
	TEST_ASSERT(!host.has_status_effect(/datum/status_effect/forced_combat/cyberpsychosis), "Keyboard input bypassed action availability.")
	toggle.action_disabled = FALSE
	host.next_click = 0 // The previous rejected input used the normal keyboard throttle.
	SEND_SIGNAL(host, COMSIG_MOB_KEYDOWN, "F6", null, "F6")
	var/datum/status_effect/forced_combat/cyberpsychosis/controlled/episode = implant.active_episode_ref?.resolve()
	TEST_ASSERT_NOTNULL(episode, "The bound key did not activate the implant.")
	var/mob/living/cyberpsychosis_backseat/seat = episode.backseat
	SEND_SIGNAL(seat, COMSIG_MOB_KEYDOWN, "F7", null, "F7")
	TEST_ASSERT(!QDELETED(episode), "An unrelated key stopped the episode.")
	SEND_SIGNAL(seat, COMSIG_MOB_KEYDOWN, "F6", null, "F6")
	TEST_ASSERT(QDELETED(episode), "The activation key did not stop the episode from the backseat.")
	TEST_ASSERT(QDELETED(seat) && !implant.stop_action, "Hotkey shutdown leaked its seat or stop action.")
	host.next_click = 0
	SEND_SIGNAL(host, COMSIG_MOB_KEYDOWN, "F6", null, "F6")
	TEST_ASSERT(!host.has_status_effect(/datum/status_effect/forced_combat/cyberpsychosis), "Keyboard input bypassed the implant cooldown.")
	COOLDOWN_RESET(implant, reactivation_cooldown)
	host.next_click = 0
	SEND_SIGNAL(host, COMSIG_MOB_KEYDOWN, "F6", null, "F6")
	episode = implant.active_episode_ref?.resolve()
	TEST_ASSERT_NOTNULL(episode, "The activation binding was lost after returning to the body.")
	qdel(episode)

/// EMP must ignore manual cooldown, lock control for 40s and injure the brain once every 2s.
/datum/unit_test/cyberpsychopath_emp/Run()
	var/mob/living/carbon/human/host = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/implant/cyberpsychopath/implant = allocate(/obj/item/implant/cyberpsychopath)
	implant.implant(host, silent = TRUE, force = TRUE)
	implant.activate()
	implant.stop_episode()
	TEST_ASSERT(!COOLDOWN_FINISHED(implant, reactivation_cooldown), "Fixture did not enter manual cooldown.")
	host.emp_act(EMP_HEAVY)
	var/datum/status_effect/forced_combat/cyberpsychosis/episode = implant.active_episode_ref?.resolve()
	TEST_ASSERT_NOTNULL(episode, "EMP did not force an episode through manual cooldown.")
	TEST_ASSERT(episode.emp_overloaded, "EMP did not lock the episode.")
	TEST_ASSERT_EQUAL(episode.duration, 40 SECONDS, "EMP fault must last 40 seconds.")
	TEST_ASSERT_NULL(implant.stop_action, "EMP fault exposed a manual shutdown action.")
	TEST_ASSERT(!implant.activate() && !implant.stop_episode(), "The EMP fault can be stopped manually.")
	TEST_ASSERT_EQUAL(host.get_organ_loss(ORGAN_SLOT_BRAIN), 0, "EMP injured the brain before the first 2-second interval.")
	// No yields: unrelated organ healing cannot change the exact damage cadence under test.
	for(var/frame in 1 to 200)
		episode.process(0.2) // The real fast-processing interval, including expiry between old 0.5s AI ticks.
		TEST_ASSERT_EQUAL(host.get_organ_loss(ORGAN_SLOT_BRAIN), FLOOR(frame / 10, 1), "Incorrect EMP brain damage at processing frame [frame].")
		if(frame == 10)
			host.emp_act(EMP_LIGHT)
			TEST_ASSERT_EQUAL(episode.duration, 38 SECONDS, "Repeated EMP refreshed the locked episode.")
	TEST_ASSERT(QDELETED(episode), "EMP episode did not finish after 40 seconds.")
	TEST_ASSERT_EQUAL(COOLDOWN_TIMELEFT(implant, reactivation_cooldown), 20 SECONDS, "EMP completion did not start the normal cooldown.")
	host.emp_act(EMP_LIGHT)
	episode = implant.active_episode_ref?.resolve()
	TEST_ASSERT_NOTNULL(episode, "A later EMP failed to start a new fault during cooldown.")
	host.death()
	TEST_ASSERT(QDELETED(episode), "Death did not end the EMP fault.")
	TEST_ASSERT_EQUAL(host.get_organ_loss(ORGAN_SLOT_BRAIN), 20, "Death applied an extra EMP brain injury.")
	TEST_ASSERT_EQUAL(COOLDOWN_TIMELEFT(implant, reactivation_cooldown), 20 SECONDS, "Death bypassed EMP cooldown cleanup.")

/// Upgrading in place preserves the seat; extraction/deletion must not cut the forced fault short.
/datum/unit_test/cyberpsychopath_emp_handoff/Run()
	for(var/manual in list(FALSE, TRUE))
		var/mob/living/carbon/human/host = allocate(/mob/living/carbon/human/consistent)
		var/obj/item/implant/cyberpsychopath/implant = allocate(/obj/item/implant/cyberpsychopath)
		implant.implant(host, silent = TRUE, force = TRUE)
		if(manual)
			implant.activate()
		else
			host.apply_status_effect(/datum/status_effect/forced_combat/cyberpsychosis)
		var/datum/status_effect/forced_combat/cyberpsychosis/episode = host.has_status_effect(/datum/status_effect/forced_combat/cyberpsychosis)
		var/mob/living/cyberpsychosis_backseat/seat = episode.backseat
		var/datum/action/cyberpsychopath_stop/stop = implant.stop_action
		episode.process(5)
		host.emp_act(EMP_HEAVY)
		TEST_ASSERT_EQUAL(implant.active_episode_ref?.resolve(), episode, "EMP replaced rather than upgraded the existing episode.")
		TEST_ASSERT_EQUAL(episode.backseat, seat, "EMP created another client handoff.")
		TEST_ASSERT_EQUAL(episode.duration, 40 SECONDS, "Existing episode did not receive a full 40-second EMP fault.")
		TEST_ASSERT(!stop || QDELETED(stop), "The old manual stop action survived EMP.")
		implant.removed(host)
		TEST_ASSERT(!QDELETED(episode), "Extraction bypassed the EMP lock.")
		TEST_ASSERT(!implant.activate(), "An extracted implant can control its locked episode.")
		qdel(implant)
		TEST_ASSERT(!QDELETED(episode), "Deleting the implant bypassed the EMP lock.")
		episode.process(39)
		TEST_ASSERT_EQUAL(host.get_organ_loss(ORGAN_SLOT_BRAIN), 19, "Delayed processing lost scheduled EMP injuries.")
		TEST_ASSERT(!QDELETED(episode), "EMP fault ended before 40 seconds after hardware deletion.")
		episode.process(1)
		TEST_ASSERT_EQUAL(host.get_organ_loss(ORGAN_SLOT_BRAIN), 20, "The final EMP injury at 40 seconds was lost.")
		TEST_ASSERT(QDELETED(episode) && QDELETED(seat), "EMP teardown leaked its effect or seat.")

/// Physical EMP propagation must respect shielding, rejection, installation and living ownership.
/datum/unit_test/cyberpsychopath_emp_protection/Run()
	var/mob/living/carbon/human/host = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/implant/cyberpsychopath/implant = allocate(/obj/item/implant/cyberpsychopath)
	implant.emp_act(EMP_HEAVY)
	TEST_ASSERT_NULL(implant.active_episode_ref, "Uninstalled hardware started a fault.")
	implant.implant(host, silent = TRUE, force = TRUE)
	implant.set_cybernetic_rejection(TRUE)
	host.emp_act(EMP_HEAVY)
	TEST_ASSERT(!host.has_status_effect(/datum/status_effect/forced_combat/cyberpsychosis), "Rejected hardware started an EMP fault.")
	implant.set_cybernetic_rejection(FALSE)
	var/obj/item/implant/empprotection/shield = allocate(/obj/item/implant/empprotection)
	shield.implant(host, silent = TRUE, force = TRUE)
	host.emp_act(EMP_HEAVY)
	TEST_ASSERT(!host.has_status_effect(/datum/status_effect/forced_combat/cyberpsychosis), "EMP bypassed protection of the host's contents.")
	shield.removed(host)
	implant.AddElement(/datum/element/empprotection, EMP_PROTECT_SELF)
	implant.emp_act(EMP_HEAVY)
	TEST_ASSERT(!host.has_status_effect(/datum/status_effect/forced_combat/cyberpsychosis), "EMP bypassed protection of the implant itself.")
	implant.RemoveElement(/datum/element/empprotection, EMP_PROTECT_SELF)
	host.death()
	host.emp_act(EMP_HEAVY)
	TEST_ASSERT(!host.has_status_effect(/datum/status_effect/forced_combat/cyberpsychosis), "Dead host received an EMP fault.")
	host.revive(ADMIN_HEAL_ALL)
	host.emp_act(EMP_HEAVY)
	var/datum/status_effect/forced_combat/cyberpsychosis/episode = implant.active_episode_ref?.resolve()
	TEST_ASSERT_NOTNULL(episode, "Unshielded living host did not receive an EMP fault.")
	qdel(episode)

/// Actual hardware must suppress automatic overload only while at least one protector is installed.
/datum/unit_test/cyberpsychopath_protection/Run()
	var/mob/living/carbon/human/host = allocate(/mob/living/carbon/human/consistent)
	var/datum/component/cyberpsychosis/load = host.GetComponent(/datum/component/cyberpsychosis)
	for(var/index in 1 to 11)
		var/obj/item/implant/tracking/tracker = allocate(/obj/item/implant/tracking)
		tracker.allow_multiple = TRUE
		tracker.implant(host, silent = TRUE, force = TRUE)
	TEST_ASSERT_EQUAL(load.load, 22, "Ordinary implants must retain their burden.")
	TEST_ASSERT_NOTNULL(load.buildup_timer, "Unprotected overload must still start buildup.")
	load.buildup = 99
	var/obj/item/implant/cyberpsychopath/protector = allocate(/obj/item/implant/cyberpsychopath)
	protector.forceMove(host)
	load.update_load()
	TEST_ASSERT(!load.buildup_blocked, "Carrying an uninstalled implant grants protection.")
	TEST_ASSERT_EQUAL(load.buildup, 99, "Carrying an uninstalled implant reset buildup.")
	protector.implant(host, silent = TRUE, force = TRUE)
	TEST_ASSERT_EQUAL(load.load, 22, "Cyberpsychopath contributed burden or erased other hardware's burden.")
	TEST_ASSERT(load.buildup_blocked, "Installed Cyberpsychopath failed to protect its host.")
	TEST_ASSERT_EQUAL(load.buildup, 0, "Installation did not reset existing buildup.")
	TEST_ASSERT_NULL(load.buildup_timer, "Installation failed to cancel the pending buildup timer.")
	load.advance_buildup()
	load.schedule_buildup()
	TEST_ASSERT_EQUAL(load.buildup, 0, "Protected host accrued spontaneous buildup.")
	TEST_ASSERT_NULL(load.buildup_timer, "Protected host restarted the timer.")
	TEST_ASSERT(!host.has_status_effect(/datum/status_effect/forced_combat/cyberpsychosis), "A stale increment started cyberpsychosis through protection.")
	var/obj/item/organ/heart/cybernetic/tier2/heart = allocate(/obj/item/organ/heart/cybernetic/tier2)
	heart.Insert(host)
	TEST_ASSERT_EQUAL(load.load, 23, "Newly installed hardware stopped being counted.")
	TEST_ASSERT_NULL(load.buildup_timer, "Installing more hardware bypassed protection.")
	TEST_ASSERT(findtext(load.get_scan_report(), "Состояние организма в норме"), "Protected host without an episode is reported as anomalous.")
	for(var/scanpower in list(SCANPOWER_BASIC, SCANPOWER_ADVANCED))
		var/report = healthscan(host, host, scanpower = scanpower, tochat = FALSE)
		TEST_ASSERT(!findtext(report, protector.name), "A health analyzer revealed Cyberpsychopath's name.")
		TEST_ASSERT(findtext(report, "Состояние организма в норме"), "A health analyzer reported protected overload as anomalous.")
	TEST_ASSERT(protector.activate(), "Overload protection blocked manual activation.")
	var/datum/status_effect/forced_combat/cyberpsychosis/controlled/episode = protector.active_episode_ref?.resolve()
	TEST_ASSERT_EQUAL(episode.duration, 20 SECONDS, "Protection changed manual episode duration.")
	TEST_ASSERT(findtext(load.get_scan_report(), "Наблюдается аномалия"), "A protected host's manual episode is hidden from scanners.")
	for(var/scanpower in list(SCANPOWER_BASIC, SCANPOWER_ADVANCED))
		var/report = healthscan(host, host, scanpower = scanpower, tochat = FALSE)
		TEST_ASSERT(!findtext(report, protector.name), "An analyzer revealed Cyberpsychopath during its episode.")
		TEST_ASSERT(findtext(report, "Наблюдается аномалия"), "An analyzer missed the controlled episode.")
	protector.stop_episode()
	TEST_ASSERT_NULL(load.buildup_timer, "Manual shutdown started spontaneous buildup through protection.")
	protector.set_cybernetic_rejection(TRUE)
	TEST_ASSERT(protector in host.implants, "Rejected protector was not physically installed.")
	TEST_ASSERT(load.buildup_blocked, "A physically installed rejected implant lost passive protection.")
	TEST_ASSERT(!protector.activate(), "Rejected implant can activate manually.")
	var/obj/item/implant/cyberpsychopath/second = allocate(/obj/item/implant/cyberpsychopath)
	second.allow_multiple = TRUE
	second.implant(host, silent = TRUE, force = TRUE)
	protector.removed(host)
	TEST_ASSERT(load.buildup_blocked, "Removing one of two protectors removed protection.")
	second.removed(host)
	TEST_ASSERT(!load.buildup_blocked, "Removing the last protector left protection active.")
	TEST_ASSERT_EQUAL(load.buildup, 0, "Removing protection restored old buildup.")
	TEST_ASSERT_NOTNULL(load.buildup_timer, "Removing the last protector did not start a fresh interval.")
	load.stop_timer()
	load.advance_buildup()
	TEST_ASSERT_EQUAL(load.buildup, 8, "Unprotected load 23 must accrue 8 per interval again.")
	protector.implant(host, silent = TRUE, force = TRUE)
	TEST_ASSERT_NULL(load.buildup_timer, "Reinstallation did not stop accumulation.")
	qdel(protector)
	TEST_ASSERT(!load.buildup_blocked, "Deleting the last protector leaked immunity.")
	TEST_ASSERT_NOTNULL(load.buildup_timer, "Deleting the last protector did not restore buildup.")
	second.implant(host, silent = TRUE, force = TRUE)
	host.death()
	host.revive(ADMIN_HEAL_ALL)
	TEST_ASSERT(load.buildup_blocked, "Revival lost protection from an installed implant.")
	TEST_ASSERT_EQUAL(load.buildup, 0, "Revival restored protected buildup.")
	TEST_ASSERT_NULL(load.buildup_timer, "Revival started buildup through protection.")
