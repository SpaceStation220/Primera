/// Both analyzer powers must report buildup/episodes without exposing hidden hardware names.
/datum/unit_test/cyberpsychosis_health_scan/Run()
	var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human/consistent)
	var/normal_text = "Состояние организма в норме, аномалий не наблюдается"
	var/anomaly_text = "Наблюдается аномалия, возможно наличие киберпсихоза"
	for(var/scanner_type in list(/obj/item/healthanalyzer, /obj/item/healthanalyzer/advanced))
		var/obj/item/healthanalyzer/scanner = allocate(scanner_type)
		var/mob/living/carbon/human/patient = allocate(/mob/living/carbon/human/consistent)
		qdel(patient.GetComponent(/datum/component/cyberpsychosis))
		var/datum/component/cyberpsychosis/load = patient.AddComponent(/datum/component/cyberpsychosis/test_outcome)
		var/report = healthscan(user, patient, scanpower = scanner.scanpower, tochat = FALSE)
		TEST_ASSERT(findtext(report, "<font color='#5599ff'>[normal_text]</font>"), "[scanner_type] did not report normal status for an unaugmented patient.")
		TEST_ASSERT(!findtext(report, anomaly_text), "A safe patient was reported as anomalous.")
		var/obj/item/organ/heart/cybernetic/tier2/heart = allocate(/obj/item/organ/heart/cybernetic/tier2)
		heart.Insert(patient)
		for(var/index in 1 to 6)
			var/obj/item/implant/tracking/tracker = allocate(/obj/item/implant/tracking)
			tracker.allow_multiple = TRUE
			tracker.implant(patient, silent = TRUE, force = TRUE)
		var/obj/item/organ/cyberimp/eyes/hud/security/syndicate/hidden = allocate(/obj/item/organ/cyberimp/eyes/hud/security/syndicate)
		hidden.Insert(patient)
		TEST_ASSERT_EQUAL(load.load, 17, "Hidden hardware did not push burden above 15.")
		TEST_ASSERT_EQUAL(load.buildup, 0, "The first buildup tick has already occurred.")
		report = healthscan(user, patient, scanpower = scanner.scanpower, tochat = FALSE)
		TEST_ASSERT(findtext(report, "<font color='#ff3333'>[anomaly_text]</font>"), "[scanner_type] missed buildup before its first increment.")
		TEST_ASSERT(!findtext(report, normal_text), "Normal and anomalous status appeared together.")
		TEST_ASSERT(!findtext(report, hidden.examine_title(user)), "The report exposed the hidden implant's name.")
		var/visible_position = findtext(report, heart.examine_title(user))
		TEST_ASSERT(visible_position && visible_position < findtext(report, anomaly_text), "Status must appear below the visible implant list.")
		load.buildup = 99
		load.stop_timer()
		load.advance_buildup()
		var/datum/status_effect/forced_combat/cyberpsychosis/episode = patient.has_status_effect(/datum/status_effect/forced_combat/cyberpsychosis)
		TEST_ASSERT_NOTNULL(episode, "The patient did not enter cyberpsychosis.")
		TEST_ASSERT_NULL(load.buildup_timer, "The episode still has a buildup timer.")
		report = healthscan(user, patient, scanpower = scanner.scanpower, tochat = FALSE)
		TEST_ASSERT(findtext(report, anomaly_text), "[scanner_type] reported an active episode as normal.")
		hidden.Remove(patient)
		report = healthscan(user, patient, scanpower = scanner.scanpower, tochat = FALSE)
		TEST_ASSERT(findtext(report, anomaly_text), "Removing hardware hid the ongoing episode.")
		qdel(episode)
		report = healthscan(user, patient, scanpower = scanner.scanpower, tochat = FALSE)
		TEST_ASSERT(findtext(report, "<font color='#5599ff'>[normal_text]</font>"), "[scanner_type] failed to return to normal after safe burden and episode end.")
		hidden.Insert(patient)
		patient.death()
		report = healthscan(user, patient, scanpower = scanner.scanpower, tochat = FALSE)
		TEST_ASSERT(findtext(report, normal_text), "A dead patient with no buildup was reported as anomalous.")
